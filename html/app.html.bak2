  </div>
  <div class="modal-body">
    <div style="padding:10px 16px;background:var(--panel2);border:1px solid var(--border);border-radius:4px;margin-bottom:16px;text-align:center">
      <div style="font-size:.6rem;color:var(--muted);letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px">Aktueller Stand</div>
      <div id="stvoCurrentPts" style="font-family:monospace;font-size:1.3rem;font-weight:700;color:var(--accent)">0 Punkte</div>
    </div>
