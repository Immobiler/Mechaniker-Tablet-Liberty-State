      <label class="form-label">Punktzahl *</label>
      <input class="form-input" id="stvoAmount" type="number" min="1" placeholder="z.B. 2" oninput="stvoUpdatePreview()"/>
    </div>
    <div class="form-group">
      <label class="form-label">Grund *</label>
      <input class="form-input" id="stvoReason" placeholder="z.B. Rotlichtverstoß..."/>
    </div>
