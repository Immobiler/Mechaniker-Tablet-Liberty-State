    '<div class="detail-field"><div class="detail-label">License Plate</div><div class="detail-value">'+ec(c.plate)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Besitzer</div><div class="detail-value">'+(c.ownerId?ec(cN(c.ownerId)):'--')+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Registriert</div><div class="detail-value">'+new Date(c.createdAt).toLocaleDateString('de-DE')+'</div></div>'+
    '</div>'+(c.ownerId?'<hr class="detail-divider"/><button class="btn btn-ghost btn-sm" onclick="closeM(\'mCarDetail\');showTab(\'citizen\');setTimeout(function(){openCitizenDetail(\''+c.ownerId+'\');},80)">Offen Bürger Profile</button>':'');
  sh('mCarDEditBtn',CUR.isMaster);sh('mCarDDelBtn',CUR.isMaster);
