      audit('CAR_DELETE','Vehicle deleted: '+p);
      closeM('mCarDetail');renderCars();toast('Fahrzeug gelöscht.','error');
    });
  };
  openM('mCarDetail');
}

function renderLexikon(){
  var grid=document.getElementById('lexikonGrid'),q=(document.getElementById('lexikonSearch').value||'').toLowerCase();
  var arr=ld('cn_lexikon');
  if(!CUR.isMaster)arr=arr.filter(function(x){return x.isActive;});
  if(q)arr=arr.filter(function(x){return x.title.toLowerCase().indexOf(q)>=0||(x.content||'').toLowerCase().indexOf(q)>=0;});
  if(!arr.length){grid.innerHTML='<div class="empty-state" style="grid-column:1/-1"><div class="empty-icon">&#x1F4DA;</div><div>Keine Einträge</div></div>';return;}
  grid.innerHTML=arr.map(function(x){return'<div class="lexikon-card" onclick="openLexikonDetail(\''+x.id+'\')">'+
    '<div class="lexikon-card-cat">'+ec(x.category||'General')+'</div>'+
    '<div class="lexikon-card-title">'+ec(x.title)+'</div>'+
    '<div class="lexikon-card-preview">'+ec(x.content||'')+'</div></div>';}).join('');
}
function openLexikonModal(editId){
  if(!CUR.isMaster){toast('Keine Berechtigung!','error');return;}
  document.getElementById('lexEditId').value=editId||'';
  document.getElementById('mLexTitle').textContent=editId?'Edit Entry':'New Entry';
  if(editId){var x=ld('cn_lexikon').find(function(x){return x.id===editId;});document.getElementById('lexTitle').value=x.title||'';document.getElementById('lexCat').value=x.category||'';document.getElementById('lexContent').value=x.content||'';document.getElementById('lexActive').value=x.isActive?'1':'0';}
  else{['lexTitle','lexCat','lexContent'].forEach(function(f){document.getElementById(f).value='';});document.getElementById('lexActive').value='1';}
  closeM('mLexDetail');openM('mLex');
}
function saveLexikon(){
  var title=document.getElementById('lexTitle').value.trim(),cat=document.getElementById('lexCat').value.trim(),
      content=document.getElementById('lexContent').value.trim(),active=document.getElementById('lexActive').value==='1',
      editId=document.getElementById('lexEditId').value;
  if(!title||!content){toast('Titel und Inhalt erforderlich!','error');return;}
  var arr=ld('cn_lexikon');
  if(editId){var i=arr.findIndex(function(x){return x.id===editId;});if(i>=0){arr[i].title=title;arr[i].category=cat;arr[i].content=content;arr[i].isActive=active;arr[i].updatedAt=new Date().toISOString();}audit('LEX_EDIT','Entry: '+title);}
  else{var nr=nId();arr.unshift({id:'lex_'+nr,nr:nr,title:title,category:cat,content:content,isActive:active,createdAt:new Date().toISOString()});audit('LEX_CREATE','Entry created: '+title);}
  sv('cn_lexikon',arr);renderLexikon();closeM('mLex');toast(editId?'Entry updated.':'Entry created.','success');
}
function openLexikonDetail(id){
  DETAIL_LEX=id;var x=ld('cn_lexikon').find(function(x){return x.id===id;});if(!x)return;
  document.getElementById('mLDTitle').textContent=x.title;
  document.getElementById('mLDBody').innerHTML=
    '<div style="margin-bottom:12px"><span class="badge badge-muted">'+ec(x.category||'General')+'</span>'+
    '<span class="badge '+(x.isActive?'badge-green':'badge-muted')+'" style="margin-left:6px">'+(x.isActive?'Active':'Inactive')+'</span></div>'+
    '<hr class="detail-divider"/>'+
    '<div style="font-size:.88rem;line-height:1.7;color:var(--text2)">'+ec(x.content).replace(/\n/g,'<br/>')+'</div>'+
    '<hr class="detail-divider"/>'+
    '<div style="font-size:.62rem;color:var(--muted)">Erstellt: '+new Date(x.createdAt).toLocaleDateString('de-DE')+(x.updatedAt?' – Geändert: '+new Date(x.updatedAt).toLocaleDateString('de-DE'):'')+'</div>';
  sh('mLDEditBtn',CUR.isMaster);sh('mLDDelBtn',CUR.isMaster);
  document.getElementById('mLDEditBtn').onclick=function(){openLexikonModal(id);};
  document.getElementById('mLDDelBtn').onclick=function(){
    var t=x.title;
    askConfirm('Really delete entry "'+t+'"?',function(){
      sv('cn_lexikon',ld('cn_lexikon').filter(function(y){return y.id!==DETAIL_LEX;}));
      audit('LEX_DELETE','Entry deleted: '+t);
      closeM('mLexDetail');renderLexikon();toast('Eintrag gelöscht.','error');
    });
  };
  openM('mLexDetail');
}

function adminSection(s){
  var content=document.getElementById('adminContent');
  // Reload CUR to ensure latest isMaster flag
  if(SESSION&&SESSION.id){var freshU=gU(SESSION.id);if(freshU)CUR=freshU;}
  if(CUR.isMaster){
    // Master hat immer Vollzugriff - keine Einschränkung
  } else if(!CUR.isMaster){
    var allowed=[];
    if(ok('job_manage')||ok('job_create'))allowed.push('jobs');
    if(!allowed.length){
      content.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1F512;</div><div>Keine Berechtigung</div></div>';
      return;
    }
    if(allowed.indexOf(s)<0){
      content.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1F512;</div><div>Keine Berechtigung</div></div>';
      return;
    }
  }
  if(s==='users'){
    var users=ld('cn_users');
    content.innerHTML='<div class="section-header" style="margin-bottom:14px"><div class="section-title" style="font-size:1rem">Users ('+users.length+')</div></div>'+
      '<div class="table-wrap"><table><thead><tr><th>CIV-ID</th><th>IC-Name</th><th>Main Job</th><th>Rang</th><th>Zweitberuf</th><th>Linked</th><th></th></tr></thead><tbody>'+
      users.map(function(u){return'<tr>'+
        '<td style="font-family:monospace;color:var(--danger)">'+ec(u.civId||'--')+'</td>'+
        '<td>'+ec(u.username)+(u.isMaster?' <span class="badge badge-danger">Master</span>':'')+'</td>'+
        '<td>'+ec(jN(u.mainJob)||'--')+'</td><td>'+ec(rN(u.mainJob,u.mainRang)||'--')+'</td>'+
        '<td>'+ec(jN(u.secondJob)||'--')+'</td>'+
        '<td>'+(u.linkedCitizenId?ec(cN(u.linkedCitizenId)):'<span style="color:var(--muted)">--</span>')+'</td>'+
        '<td>'+(u.isMaster?'':'<button class="btn btn-ghost btn-sm" onclick="openAdminUser(\''+u.id+'\')">Bearbeiten</button>')+'</td>'+
        '</tr>';}).join('')+'</tbody></table></div>';
  }
  if(s==='jobs'){
    var jobs=ld('cn_jobs');
    var canManage=CUR.isMaster||ok('job_manage');
    var canCreate=canManage||ok('job_create');
    content.innerHTML='<div class="section-header" style="margin-bottom:14px"><div class="section-title" style="font-size:1rem">Jobs ('+jobs.length+')</div>'+
      (canCreate?'<button class="btn btn-primary btn-sm" onclick="openAdminJob(null)">+ Create Job</button>':'')+
      (!canManage&&ok('job_create')?'<div style="font-size:.62rem;color:var(--muted);margin-top:4px;margin-left:8px">&#x26A0; Nur neue Jobs erstellen möglich – kein Bearbeiten/Löschen</div>':'')+
      '</div>'+
      '<div class="card-list">'+jobs.map(function(j){return'<div class="card" style="cursor:default">'+
        '<div class="card-left"><div class="card-label">'+(j.isSystem?'System':j.isSecondJob?'Zweitberuf':'Job')+'</div><div class="card-title">'+ec(j.name)+'</div></div>'+
        '<div class="card-right"><span class="card-meta">'+j.ranks.length+' Rangs</span>'+
        (canManage&&(!j.isSystem||CUR.isMaster)?'<button class="btn btn-ghost btn-sm" onclick="openAdminJob(\''+j.id+'\')">Bearbeiten</button>':'')+
        (canManage&&(!j.isSystem||CUR.isMaster)?'<button class="btn btn-danger btn-sm" onclick="promptDeleteJob(\''+j.id+'\')">Löschen</button>':'')+
        '</div></div>';}).join('')+'</div>';
  }
  if(s==='passwords'){
    var users=ld('cn_users');
    content.innerHTML='<div class="section-title" style="font-size:1rem;margin-bottom:12px">Alle Passwörter</div>'+
      '<div style="padding:10px 14px;background:rgba(190,6,6,.08);border:1px solid rgba(190,6,6,.2);font-size:.72rem;color:var(--danger);margin-bottom:14px">Only visible to Master account.</div>'+
      '<div class="table-wrap"><table><thead><tr><th>CIV-ID</th><th>IC-Name</th><th>Passwort</th></tr></thead><tbody>'+
      users.map(function(u){return'<tr><td style="font-family:monospace;color:var(--danger)">'+ec(u.civId||'--')+'</td><td>'+ec(u.username)+'</td><td style="font-family:monospace;color:var(--accent)">'+ec(u.password)+'</td></tr>';}).join('')+
      '</tbody></table></div>';
  }
  if(s==='audit'){
    var logs=ld('cn_audit').slice(0,100);
    content.innerHTML='<div class="section-title" style="font-size:1rem;margin-bottom:12px">Aktivitätslog (last 100)</div>'+
      '<div class="table-wrap"><table><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody>'+
      logs.map(function(l){return'<tr><td>'+new Date(l.ts).toLocaleString('de-DE')+'</td><td>'+ec(l.username||l.userId||'--')+'</td><td><span class="badge badge-muted">'+ec(l.action)+'</span></td><td>'+ec(l.detail||'--')+'</td></tr>';}).join('')+
      '</tbody></table></div>';
  }
  if(s==='tokens'){
    // Show local tokens from localStorage
    var users = ld('cn_users');
    content.innerHTML =
      '<div class="section-header" style="margin-bottom:14px">'+
      '<div class="section-title" style="font-size:1rem">Registrierungs-Tokens</div>'+
      '<button class="btn btn-ghost btn-sm" onclick="loadTokensFromServer()">&#x21BB; Vom Server laden</button></div>'+
      '<div style="padding:10px 14px;background:rgba(200,169,110,.06);border:1px solid rgba(200,169,110,.2);font-size:.72rem;color:var(--text2);margin-bottom:14px">'+
      'Tokens are automatically generated when joining. Each player gets exactly one token to register.</div>'+
      '<div id="tokenTableWrap">'+
      '<div class="table-wrap"><table><thead><tr>'+
      '<th>Token</th><th>Spielername (FiveM)</th><th>Identifier</th><th>Status</th><th>Genutzt von</th><th>Datum</th></tr></thead><tbody>'+
      users.filter(function(u){return u.registrationToken;}).map(function(u){
        return'<tr>'+
          '<td style="font-family:monospace;color:var(--accent);letter-spacing:.1em">'+ec(u.registrationToken||'--')+'</td>'+
          '<td>'+ec(u.username||'--')+'</td>'+
          '<td style="font-size:.62rem;color:var(--muted)">'+ec(u.identifier||'--')+'</td>'+
          '<td><span class="badge badge-green">Genutzt</span></td>'+
          '<td>'+ec(u.username||'--')+'</td>'+
          '<td>'+new Date(u.createdAt||Date.now()).toLocaleDateString('de-DE')+'</td>'+
          '</tr>';
      }).join('')+
      '</tbody></table></div></div>';
    // If FiveM available: load real DB tokens
    loadTokensFromServer();
  }
}

function promptDeleteJob(id){
  var j=gJ(id);if(!j)return;
  askConfirm('Beruf wirklich löschen "'+j.name+'"? Users will be set to Arbeitslos.',function(){
    var users=ld('cn_users');
    users.forEach(function(u){if(u.mainJob===id){u.mainJob='job_arbeitslos';u.mainRang='rank_al_1';}});
    sv('cn_users',users);sv('cn_jobs',ld('cn_jobs').filter(function(x){return x.id!==id;}));
    audit('JOB_DELETE','Job deleted: '+j.name);
    adminSection('jobs');toast('Beruf gelöscht.','error');
  });
}

function openAdminUser(uid){
  EDIT_USER=uid;var u=gU(uid);
  var jobs=ld('cn_jobs').filter(function(j){return!j.isSecondJob;}),sJobs=ld('cn_jobs').filter(function(j){return j.isSecondJob;});
  var rOpts='';if(u.mainJob){var j=gJ(u.mainJob);if(j)rOpts=j.ranks.map(function(r){return'<option value="'+r.id+'"'+(r.id===u.mainRang?' selected':'')+'>'+ec(r.name)+' (Lv.'+r.level+')</option>';}).join('');}
  document.getElementById('mAUTitle').textContent='User: '+u.username+' ('+( u.civId||'--')+')';
  document.getElementById('mAUBody').innerHTML=
    '<div class="form-group"><label class="form-label">Main Job</label>'+
    '<select class="form-select" id="auJob" onchange="updAURang()">'+
    jobs.map(function(j){return'<option value="'+j.id+'"'+(j.id===u.mainJob?' selected':'')+'>'+ec(j.name)+'</option>';}).join('')+'</select></div>'+
    '<div class="form-group"><label class="form-label">Rang</label><select class="form-select" id="auRang">'+rOpts+'</select></div>'+
    '<div class="form-group"><label class="form-label">Zweitberuf</label>'+
    '<select class="form-select" id="auSecond"><option value="">-- kein Zweitberuf --</option>'+
    sJobs.map(function(j){return'<option value="'+j.id+'"'+(j.id===u.secondJob?' selected':'')+'>'+ec(j.name)+'</option>';}).join('')+'</select></div>'+
    '<hr class="detail-divider"/>'+
    '<div class="form-label" style="margin-bottom:8px">Individuelle Zusatzrechte</div>'+
    '<div class="rights-grid">'+ALL_RIGHTS.filter(function(r){return r!=='job_create';}).map(function(r){
      var labels={
        doc_create:'Dokumente erstellen',doc_read:'Dokumente lesen',doc_edit:'Dokumente bearbeiten',
        doc_delete:'Dokumente löschen',
        wanted_manage:'Wanted verwalten',map_view:'Live-Karte',
        stvo_manage:'StVO Punkte vergeben',give_job:'Job vergeben',citizen_view:'Bürger sehen',job_manage:'Jobs erstellen/bearbeiten',doc_type_manage:'Dok-Typen & Berechtigungen'
      };
      return'<label class="right-item"><input type="checkbox" id="ar_'+r+'"'+((u.rights||[]).indexOf(r)>=0?' checked':'')+'/> '+(labels[r]||r)+'</label>';
    }).join('')+'</div>'+
    '<hr class="detail-divider" style="margin:10px 0"/>'+
    '<div class="form-label" style="margin-bottom:4px;color:var(--accent)">&#x1F511; Charakter-Sonderrecht</div>'+
    '<div style="font-size:.65rem;color:var(--muted);margin-bottom:8px">Dieses Recht wirkt nur als individuelles Charakter-Recht – nicht über Rang-Berechtigungen vergebbar.</div>'+
    '<div style="display:flex;flex-wrap:wrap;gap:8px">'+
    '<label class="right-item" style="border:1px solid var(--accent);padding:4px 8px;border-radius:4px"><input type="checkbox" id="ar_job_create"'+((u.rights||[]).indexOf('job_create')>=0?' checked':'')+'/> &#x1F4BC; Jobs erstellen (Berufe &amp; Ränge)</label>'+
    '</div>';
  openM('mAdminUser');
}
function updAURang(){
  var j=gJ(document.getElementById('auJob').value),sel=document.getElementById('auRang');
  sel.innerHTML=j?j.ranks.map(function(r){return'<option value="'+r.id+'">'+ec(r.name)+' (Lv.'+r.level+')</option>';}).join(''):'';
}
function saveAdminUser(){
  var mainJob=document.getElementById('auJob').value,mainRang=document.getElementById('auRang').value,
      secondJob=document.getElementById('auSecond').value,j2=secondJob?gJ(secondJob):null,
      secondRang=j2&&j2.ranks.length?j2.ranks[0].id:null;
  var rights=ALL_RIGHTS.filter(function(r){var el=document.getElementById('ar_'+r);return el&&el.checked;});
  var users=ld('cn_users'),i=users.findIndex(function(u){return u.id===EDIT_USER;});
  if(i>=0){users[i].mainJob=mainJob;users[i].mainRang=mainRang;users[i].secondJob=secondJob||null;users[i].secondRang=secondRang;users[i].rights=rights;}
  sv('cn_users',users);audit('ADMIN_USER_EDIT','User edited: '+(users[i]&&users[i].username));
  closeM('mAdminUser');adminSection('users');toast('Benutzer gespeichert.','success');
}

function openAdminJob(jobId){
  EDIT_JOB=jobId;var j=jobId?gJ(jobId):null;
  document.getElementById('mAJTitle').textContent=jobId?('Job: '+(j&&j.name)):'Neuer Beruf';
  document.getElementById('mAJBody').innerHTML=
    '<div class="form-group"><label class="form-label">Name *</label><input class="form-input" id="ajName" value="'+ec(j&&j.name||'')+'"/></div>'+
    '<div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" id="ajDesc" style="height:70px">'+ec(j&&j.description||'')+'</textarea></div>'+
    '<hr class="detail-divider"/>'+
    '<div class="section-header"><div style="font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em">Rangs</div>'+
    '<button class="btn btn-ghost btn-sm" onclick="addRang()">+ Rang</button></div>'+
    '<div id="ajRangs">'+(j&&j.ranks||[]).map(function(r,i){return rankHTML(r,i);}).join('')+'</div>';
  openM('mAdminJob');
}
function rankDocHTML(i,allowedTypes){
  var types=getDocTypes();
  return types.map(function(t){
    var checked=(!allowedTypes||allowedTypes.length===0||allowedTypes.indexOf(t.name)>=0)?' checked':'';
    return'<label style="display:flex;align-items:center;gap:4px;font-size:.65rem;color:var(--text2);white-space:nowrap">'+
      '<input type="checkbox" id="rdoc_'+i+'_'+t.name.replace(/\s/g,'_')+'"'+checked+'/> '+ec(t.name)+'</label>';
  }).join('');
}
function getRankDocTypes(i){
  var types=getDocTypes();
  var allowed=types.filter(function(t){
    var el=document.getElementById('rdoc_'+i+'_'+t.name.replace(/\s/g,'_'));
    return el&&el.checked;
  }).map(function(t){return t.name;});
  return allowed;
}
var _editRankIdx=null;

function openRankEdit(i){
  _editRankIdx=i;
  var rangName=document.getElementById('rn_'+i)?document.getElementById('rn_'+i).value:'';
  document.getElementById('mRETitle').textContent='Rang-Einstellungen: '+rangName;
  
  var mapRules=[];var profRules=[];var allowedDocs=[];var crossVis={};
  var docEditRules=[];var docDeleteRules=[];
  try{mapRules=JSON.parse(document.getElementById('rMapRules_'+i).value||'[]');}catch(e){}
  try{profRules=JSON.parse(document.getElementById('rProfRules_'+i).value||'[]');}catch(e){}
  try{allowedDocs=JSON.parse(document.getElementById('rDocTypes_'+i).value||'[]');}catch(e){}
  try{crossVis=JSON.parse(document.getElementById('rCrossVis_'+i).value||'{}');}catch(e){}
  try{docEditRules=JSON.parse(document.getElementById('rDocEditRules_'+i).value||'[]');}catch(e){}
  try{docDeleteRules=JSON.parse(document.getElementById('rDocDeleteRules_'+i).value||'[]');}catch(e){}
  
  var allJobs=ld('cn_jobs');
  var allTypes=getDocTypes();

  var mapRows=mapRules.map(function(r,ri){return buildRuleRow('re_map',ri,r,allJobs);}).join('');
  var profRows=profRules.map(function(r,ri){return buildRuleRow('re_prof',ri,r,allJobs);}).join('');
  var editRows=docEditRules.map(function(r,ri){return buildRuleRow('re_dedit',ri,r,allJobs);}).join('');
  var delRows=docDeleteRules.map(function(r,ri){return buildRuleRow('re_ddel',ri,r,allJobs);}).join('');

  var docBoxes=allTypes.map(function(t){
    var ck=(!allowedDocs.length||allowedDocs.indexOf(t.name)>=0)?' checked':'';
    return'<label style="display:flex;align-items:center;gap:6px;font-size:.75rem;padding:6px 10px;background:var(--panel);border:1px solid var(--border);border-radius:3px;cursor:pointer">'+
      '<input type="checkbox" id="re_doc_'+t.name.replace(/\s/g,'_')+'"'+ck+'/> '+ec(t.name)+'</label>';
  }).join('');

  var otherJobs=allJobs.filter(function(j){return!j.isSecondJob;});
  var crossHTML=otherJobs.map(function(job){
    var rows=job.ranks.map(function(rank){
      var key=job.id+'::'+rank.id;
      var ck=(crossVis[key]!==false)?' checked':'';
      return'<label style="display:flex;align-items:center;gap:5px;font-size:.7rem;color:var(--text2);padding:3px 8px;background:var(--panel);border:1px solid var(--border);border-radius:2px;white-space:nowrap">'+
        '<input type="checkbox" id="re_cv_'+job.id+'__'+rank.id+'"'+ck+'/> '+
        ec(rank.name)+' <span style="color:var(--muted);font-size:.58rem">(Lv.'+rank.level+')</span></label>';
    }).join('');
    return'<div style="margin-bottom:12px">'+
      '<div style="font-size:.65rem;color:var(--accent);margin-bottom:5px;font-weight:600">'+ec(job.name)+'</div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:5px">'+rows+'</div></div>';
  }).join('');

  function ruleSection(label,hint,id,rows,addFn){
    return'<div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:6px">'+label+'</div>'+
      '<div style="font-size:.63rem;color:var(--text2);margin-bottom:6px">'+hint+'</div>'+
      '<div id="'+id+'">'+rows+'</div>'+
      '<button class="btn btn-ghost btn-sm" style="margin-top:5px;font-size:.67rem" onclick="reAddRule(\''+addFn+'\')">+ Job-Regel</button>'+
      '<hr style="border-color:var(--border);margin:14px 0"/>';
  }

  document.getElementById('mREBody').innerHTML=
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">'+
    '<div>'+
    ruleSection('🗺 Karte — Wer sieht diesen Rang?','Leer = alle.','re_mapRows',mapRows,'re_map')+
    ruleSection('👤 Profil — Wer kann es einsehen?','Leer = alle.','re_profRows',profRows,'re_prof')+
    '<div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:6px">📄 Erlaubte Dokumenttypen</div>'+
    '<div style="font-size:.63rem;color:var(--text2);margin-bottom:6px">Alle angehakt = alle erlaubt.</div>'+
    '<div style="display:flex;flex-wrap:wrap;gap:6px" id="re_docBoxes">'+docBoxes+'</div>'+
    '</div>';
  openM('mRankEdit');
}

  // Karte-Regeln
  var mapRows=mapRules.map(function(r,ri){
    return buildRuleRow('re_map',ri,r,allJobs);
  }).join('');
  // Profil-Regeln
  var profRows=profRules.map(function(r,ri){
    return buildRuleRow('re_prof',ri,r,allJobs);
  }).join('');
  // Dokument-Checkboxen
  var docBoxes=allTypes.map(function(t){
    var ck=(!allowedDocs.length||allowedDocs.indexOf(t.name)>=0)?' checked':'';
    return'<label style="display:flex;align-items:center;gap:6px;font-size:.75rem;padding:6px 10px;background:var(--panel);border:1px solid var(--border);border-radius:3px;cursor:pointer">'+
      '<input type="checkbox" id="re_doc_'+t.name.replace(/\s/g,'_')+'"'+ck+'/> '+ec(t.name)+'</label>';
  }).join('');

  // Cross-Visibility Matrix
  var otherJobs=allJobs.filter(function(j){return!j.isSecondJob;});
  var crossHTML=otherJobs.map(function(job){
    var rows=job.ranks.map(function(rank){
      var key=job.id+'::'+rank.id;
      var ck=(crossVis[key]!==false)?' checked':'';
      return'<label style="display:flex;align-items:center;gap:5px;font-size:.7rem;color:var(--text2);padding:3px 8px;background:var(--panel);border:1px solid var(--border);border-radius:2px;white-space:nowrap">'+
        '<input type="checkbox" id="re_cv_'+job.id+'__'+rank.id+'"'+ck+'/> '+
        ec(rank.name)+' <span style="color:var(--muted);font-size:.58rem">(Lv.'+rank.level+')</span></label>';
    }).join('');
    return'<div style="margin-bottom:12px">'+
      '<div style="font-size:.65rem;color:var(--accent);margin-bottom:5px;font-weight:600">'+ec(job.name)+'</div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:5px">'+rows+'</div></div>';
  }).join('');

  document.getElementById('mREBody').innerHTML=
    '<div>'+
    '<div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:8px">🗺 Karte — Wer sieht diesen Rang?</div>'+
    '<div style="font-size:.63rem;color:var(--text2);margin-bottom:8px">Leer = alle können ihn sehen.</div>'+
    '<div id="re_mapRows">'+mapRows+'</div>'+
    '<button class="btn btn-ghost btn-sm" style="margin-top:6px;font-size:.67rem" onclick="reAddRule(\'re_map\')">+ Job-Regel hinzufügen</button>'+
    '<hr style="border-color:var(--border);margin:16px 0"/>'+
    '<div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:8px">👤 Profil — Wer kann das Profil einsehen?</div>'+
    '<div style="font-size:.63rem;color:var(--text2);margin-bottom:8px">Leer = alle können es einsehen.</div>'+
    '<div id="re_profRows">'+profRows+'</div>'+
    '<button class="btn btn-ghost btn-sm" style="margin-top:6px;font-size:.67rem" onclick="reAddRule(\'re_prof\')">+ Job-Regel hinzufügen</button>'+
    '<hr style="border-color:var(--border);margin:16px 0"/>'+
    '<div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-bottom:8px">📄 Erlaubte Dokumenttypen</div>'+
    '<div style="font-size:.63rem;color:var(--text2);margin-bottom:8px">Alle angehakt = alle Typen erlaubt.</div>'+
    '<div style="display:flex;flex-wrap:wrap;gap:6px" id="re_docBoxes">'+docBoxes+'</div>'+
    '</div>';
  openM('mRankEdit');
}

function buildRuleRow(prefix,ri,rule,allJobs){
  var mainJobs=allJobs.filter(function(j){return!j.isSecondJob;});
  var jobOpts='<option value="">-- alle Jobs --</option>'+mainJobs.map(function(j){
    return'<option value="'+j.id+'"'+(rule.jobId===j.id?' selected':'')+'>'+ec(j.name)+'</option>';
  }).join('');
  return'<div class="re_ruleRow" style="display:flex;gap:6px;align-items:center;margin-bottom:6px">'+
    '<select class="form-select" id="'+prefix+'_job_'+ri+'" style="flex:1;font-size:.72rem">'+jobOpts+'</select>'+
    '<span style="font-size:.65rem;color:var(--muted);white-space:nowrap">ab Lv.</span>'+
    '<input type="number" class="form-input" id="'+prefix+'_lv_'+ri+'" value="'+(rule.minLevel||0)+'" min="0" max="999" style="width:60px;font-size:.72rem"/>'+
    '<button class="btn btn-danger btn-sm" style="padding:4px 8px" onclick="this.parentElement.remove()">✕</button>'+
    '</div>';
}

function reAddRule(prefix){
  var container=document.getElementById(prefix+'Rows');
  var existing=container.querySelectorAll('.re_ruleRow').length;
  var d=document.createElement('div');
  d.innerHTML=buildRuleRow(prefix,existing,{jobId:'',minLevel:0},ld('cn_jobs'));
  container.appendChild(d.firstElementChild);
}

function saveRankEdit(){
  var i=_editRankIdx;
  if(i===null)return;
  function readRules(prefix,containerId){
    var rules=[];
    document.querySelectorAll('#'+containerId+' .re_ruleRow').forEach(function(row,ri){
      var jEl=document.getElementById(prefix+'_job_'+ri),lEl=document.getElementById(prefix+'_lv_'+ri);
      if(jEl&&lEl)rules.push({jobId:jEl.value,minLevel:parseInt(lEl.value)||0});
    });
    return rules;
  }
  var mapRules=readRules('re_map','re_mapRows');
  var profRules=readRules('re_prof','re_profRows');
  var docEditRules=readRules('re_dedit','re_deditRows');
  var docDeleteRules=readRules('re_ddel','re_ddelRows');
  var allTypes=getDocTypes();
  var allowedDocs=allTypes.filter(function(t){
    var el=document.getElementById('re_doc_'+t.name.replace(/\s/g,'_'));
    return el&&el.checked;
  }).map(function(t){return t.name;});
  if(allowedDocs.length===allTypes.length)allowedDocs=[];
  var crossVis={};
  var allJobs=ld('cn_jobs').filter(function(j){return!j.isSecondJob;});
  allJobs.forEach(function(job){
    job.ranks.forEach(function(rank){
      var el=document.getElementById('re_cv_'+job.id+'__'+rank.id);
      if(el)crossVis[job.id+'::'+rank.id]=el.checked;
    });
  });
  document.getElementById('rMapRules_'+i).value=JSON.stringify(mapRules);
  document.getElementById('rProfRules_'+i).value=JSON.stringify(profRules);
  document.getElementById('rDocTypes_'+i).value=JSON.stringify(allowedDocs);
  document.getElementById('rCrossVis_'+i).value=JSON.stringify(crossVis);
  document.getElementById('rDocEditRules_'+i).value=JSON.stringify(docEditRules);
  document.getElementById('rDocDeleteRules_'+i).value=JSON.stringify(docDeleteRules);
  var btn=document.querySelector('[data-ri="'+i+'"] .btn-ghost');
  if(btn){
    var badges='';
    if(mapRules.length)badges+=' 🗺'+mapRules.length;
    if(profRules.length)badges+=' 👤'+profRules.length;
    if(allowedDocs.length)badges+=' 📄'+allowedDocs.length;
    if(docEditRules.length)badges+=' ✏️'+docEditRules.length;
    if(docDeleteRules.length)badges+=' 🗑'+docDeleteRules.length;
    btn.textContent='⚙ Erweitert'+(badges?badges:'');
  }
  closeM('mRankEdit');
  toast('Rang-Einstellungen übernommen.','success');
}

function rankRulesHTML(type,i,rules){}
function getRankRulesFromDOM(type,i){return[];}
function updateRankBtn(type,i,count){}
function addRankRule(type,i){}
function removeRankRule(type,i,ri){}
function toggleRankSection(type,i){}

function rankHTML(r,i){
  var mapRules=(r&&r.mapAccessRules)||[];
  var profRules=(r&&r.profileAccessRules)||[];
  var allowedDocs=(r&&r.allowedDocTypes)||[];
  var allTypes=getDocTypes();
  var badges='';
  if(mapRules.length)badges+=' <span style="font-size:.55rem;background:rgba(200,169,110,.15);color:var(--accent);padding:1px 5px;border-radius:2px">🗺'+mapRules.length+'</span>';
  if(profRules.length)badges+=' <span style="font-size:.55rem;background:rgba(200,169,110,.15);color:var(--accent);padding:1px 5px;border-radius:2px">👤'+profRules.length+'</span>';
  if(allowedDocs.length&&allowedDocs.length<allTypes.length)badges+=' <span style="font-size:.55rem;background:rgba(200,169,110,.15);color:var(--accent);padding:1px 5px;border-radius:2px">📄'+allowedDocs.length+'</span>';
  return'<div style="background:var(--panel2);border:1px solid var(--border);padding:10px 12px;margin-bottom:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap" data-ri="'+i+'">'+
    '<input class="form-input" style="flex:1;min-width:130px" placeholder="Rang Name" value="'+ec(r&&r.name||'')+'" id="rn_'+i+'"/>'+
    '<input class="form-input" style="width:72px" type="number" placeholder="Level" value="'+(r&&r.level||(i+1))+'" id="rl_'+i+'"/>'+
    '<select class="form-select" style="width:95px" id="rdl_'+i+'" title="Document Access Level">'+
    '<option value="0"'+((!r||!r.docAccessLevel||r.docAccessLevel===0)?' selected':'')+'>Doc: 0</option>'+
    '<option value="1"'+((r&&r.docAccessLevel===1)?' selected':'')+'>Doc: 1</option>'+
    '<option value="2"'+((r&&r.docAccessLevel===2)?' selected':'')+'>Doc: 2</option>'+
    '<option value="3"'+((r&&r.docAccessLevel===3)?' selected':'')+'>Doc: 3</option>'+
    '<option value="4"'+((r&&r.docAccessLevel===4)?' selected':'')+'>Doc: 4</option>'+
    '<option value="5"'+((r&&r.docAccessLevel===5)?' selected':'')+'>Doc: 5</option>'+
    '</select>'+
    '<button class="btn btn-ghost btn-sm" style="font-size:.68rem;white-space:nowrap" onclick="openRankEdit('+i+')">⚙ Erweitert'+badges+'</button>'+
    '<button class="btn btn-danger btn-sm" onclick="this.closest(\'[data-ri]\').remove()">X</button>'+
    '<div style="width:100%;display:flex;flex-wrap:wrap;gap:6px;margin-top:6px">'+
    ALL_RIGHTS.filter(function(right){return right!=='job_create';}).map(function(right){
      var labels={
        doc_create:'Doks. erstellen',doc_read:'Doks. lesen',doc_edit:'Doks. bearbeiten',
        doc_delete:'Doks. löschen',
        wanted_manage:'Wanted',map_view:'Live-Karte',
        stvo_manage:'StVO Punkte',give_job:'Job vergeben',citizen_view:'Bürger sehen',job_manage:'Jobs erstellen',doc_type_manage:'Dok-Typen'
      };
      return'<label style="display:flex;align-items:center;gap:4px;font-size:.67rem;color:var(--text2)">'+
      '<input type="checkbox" id="rr_'+i+'_'+right+'"'+((r&&r.rights||[]).indexOf(right)>=0?' checked':'')+'/> '+(labels[right]||right)+'</label>';}).join('')+
    '</div>'+
    // Versteckte Datenfelder für Rang-Einstellungen
    '<input type="hidden" id="rMapRules_'+i+'" value=\''+JSON.stringify(mapRules)+'\'>'+
    '<input type="hidden" id="rProfRules_'+i+'" value=\''+JSON.stringify(profRules)+'\'>'+
    '<input type="hidden" id="rDocTypes_'+i+'" value=\''+JSON.stringify(allowedDocs)+'\'>'+
    '<input type="hidden" id="rCrossVis_'+i+'" value=\''+JSON.stringify((r&&r.crossVisibility)||{})+'\'>'+
    '<input type="hidden" id="rDocEditRules_'+i+'" value=\''+JSON.stringify((r&&r.docEditRules)||[])+'\'>'+
    '<input type="hidden" id="rDocDeleteRules_'+i+'" value=\''+JSON.stringify((r&&r.docDeleteRules)||[])+'\'>'+
    '</div>';
}
function addRang(){
  var c=document.getElementById('ajRangs'),d=document.createElement('div');
  d.innerHTML=rankHTML({name:'',level:rankIdx,rights:[],docAccessLevel:2,mapAccessRules:[],profileAccessRules:[],allowedDocTypes:[]},rankIdx);
  c.appendChild(d.firstElementChild);rankIdx++;
}
function saveAdminJob(){
  var name=document.getElementById('ajName').value.trim(),desc=document.getElementById('ajDesc').value.trim();
  if(!name){toast('Name ist erforderlich!','error');return;}
  var rankEls=document.querySelectorAll('#ajRangs [data-ri]');
  var ranks=Array.from(rankEls).map(function(el){
    var i=el.getAttribute('data-ri');
    var rights=ALL_RIGHTS.filter(function(r){var el2=el.querySelector('#rr_'+i+'_'+r);return el2&&el2.checked;});
    var docAccessLevel=parseInt((el.querySelector('#rdl_'+i)&&el.querySelector('#rdl_'+i).value)||'0');
    var existing=EDIT_JOB&&gJ(EDIT_JOB)&&gJ(EDIT_JOB).ranks[i];
    var mapRules=[];var profRules=[];var allowedDocs=[];var crossVis={};var docEditRules=[];var docDeleteRules=[];
    try{mapRules=JSON.parse((el.querySelector('#rMapRules_'+i)||{value:'[]'}).value);}catch(e){}
    try{profRules=JSON.parse((el.querySelector('#rProfRules_'+i)||{value:'[]'}).value);}catch(e){}
    try{allowedDocs=JSON.parse((el.querySelector('#rDocTypes_'+i)||{value:'[]'}).value);}catch(e){}
    try{crossVis=JSON.parse((el.querySelector('#rCrossVis_'+i)||{value:'{}'}).value);}catch(e){}
    try{docEditRules=JSON.parse((el.querySelector('#rDocEditRules_'+i)||{value:'[]'}).value);}catch(e){}
    try{docDeleteRules=JSON.parse((el.querySelector('#rDocDeleteRules_'+i)||{value:'[]'}).value);}catch(e){}
    return{
      id:existing&&existing.id||'rank_'+nId(),
      name:(el.querySelector('#rn_'+i)&&el.querySelector('#rn_'+i).value.trim())||'Rang',
      level:parseInt((el.querySelector('#rl_'+i)&&el.querySelector('#rl_'+i).value)||'1'),
      rights:rights,
      docAccessLevel:docAccessLevel,
      mapAccessRules:mapRules,
      profileAccessRules:profRules,
      allowedDocTypes:allowedDocs,
      crossVisibility:crossVis,
      docEditRules:docEditRules,
      docDeleteRules:docDeleteRules
    };
  });
  var jobs=ld('cn_jobs');
  if(EDIT_JOB){var i=jobs.findIndex(function(j){return j.id===EDIT_JOB;});if(i>=0){jobs[i].name=name;jobs[i].description=desc;jobs[i].ranks=ranks;}audit('JOB_EDIT','Job edited: '+name);}
  else{jobs.push({id:'job_'+nId(),name:name,description:desc,isSystem:false,isSecondJob:false,ranks:ranks});audit('JOB_CREATE','Job created: '+name);}
  sv('cn_jobs',jobs);closeM('mAdminJob');adminSection('jobs');toast('Beruf gespeichert.','success');
}

function openDocTypesManager(){
  if(!CUR.isMaster&&!ok('doc_type_manage')){toast('Keine Berechtigung!','error');return;}
  var types=getDocTypes();
  var body=document.getElementById('mDocTypesBody');
  body.innerHTML='<div style="margin-bottom:14px;display:flex;justify-content:space-between;align-items:center">'+
    '<div style="font-size:.72rem;color:var(--muted)">Define document types and edit templates.</div>'+
    '<button class="btn btn-primary btn-sm" onclick="openDocTypeEdit(null)">+ New Type</button></div>'+
    '<div class="card-list">'+types.map(function(t,i){
      return'<div class="card" style="cursor:default">'+
        '<div class="card-left"><div class="card-title">'+ec(t.name)+'</div>'+
        '<div style="font-size:.6rem;color:var(--muted);margin-top:2px">'+(t.template?'Vorlage vorhanden':'Keine Vorlage')+
        (t.visLevel?' &nbsp;|&nbsp; Sehen: Stufe '+t.visLevel+'+':' &nbsp;|&nbsp; Sehen: Alle')+
        (t.editLevel?' &nbsp;|&nbsp; Bearbeiten: Stufe '+t.editLevel+'+':' &nbsp;|&nbsp; Bearbeiten: Alle')+
        '</div></div>'+
        '<div class="card-right">'+
        '<button class="btn btn-ghost btn-sm" onclick="openDocTypeEdit(\''+ec(t.name)+'\')">Bearbeiten</button>'+
        (i>=5?'<button class="btn btn-danger btn-sm" onclick="deleteDocType(\''+ec(t.name)+'\')">X</button>':'')+
        '</div></div>';
    }).join('')+'</div>';
  openM('mDocTypes');
}
function openDocTypeEdit(name){
  var types=getDocTypes();
  var t=name?types.find(function(x){return x.name===name;}):null;
  document.getElementById('mDTETitle').textContent=name?'Typ bearbeiten: '+name:'Create New Type';
  document.getElementById('dteEditName').value=name||'';
  document.getElementById('dteName').value=t?t.name:'';
  document.getElementById('dteHeader').value=t?t.headerText||'':'';
  document.getElementById('dteTemplate').value=t?t.template||'':'';
  document.getElementById('dteVisLevel').value=t&&t.visLevel!=null?String(t.visLevel):'0';
  document.getElementById('dteEditLevel').value=t&&t.editLevel!=null?String(t.editLevel):'0';
  openM('mDocTypeEdit');
}
function saveDocType(){
  var newName=document.getElementById('dteName').value.trim();
  var hdr=document.getElementById('dteHeader').value;
  var tpl=document.getElementById('dteTemplate').value;
  var visLevel=parseInt(document.getElementById('dteVisLevel').value)||0;
  var editLevel=parseInt(document.getElementById('dteEditLevel').value)||0;
  var editName=document.getElementById('dteEditName').value;
  if(!newName){toast('Name ist erforderlich!','error');return;}
  var types=getDocTypes();
  if(editName){
    var i=types.findIndex(function(x){return x.name===editName;});
    if(i>=0){types[i].name=newName;types[i].headerText=hdr;types[i].template=tpl;types[i].visLevel=visLevel;types[i].editLevel=editLevel;}
  }else{
    if(types.find(function(x){return x.name===newName;})){toast('Type already exists!','error');return;}
    types.push({name:newName,headerText:hdr,template:tpl,visLevel:visLevel,editLevel:editLevel});
  }
  localStorage.setItem('cn_doc_types',JSON.stringify(types));
  closeM('mDocTypeEdit');
  openDocTypesManager();
  toast('Typ gespeichert.','success');
}
function deleteDocType(name){
  askConfirm('Really delete type "'+name+'"?',function(){
    var types=getDocTypes().filter(function(x){return x.name!==name;});
    localStorage.setItem('cn_doc_types',JSON.stringify(types));
    openDocTypesManager();
    toast('Typ gelöscht.','error');
  });
}
function canAccessProfile(citizenId){
  if(CUR.isMaster)return true;
  if(!citizenId)return true;
  var c=ld('cn_citizens').find(function(x){return String(x.id)===String(citizenId);});
  if(!c)return true;
  var r=gR(c.jobId,c.rankId);
  var rules=r&&r.profileAccessRules;
  if(!rules||rules.length===0)return true;
  return rules.some(function(rule){
    if(!rule.jobId)return true;
    var myJobs=[
      {job:CUR.mainJob,rank:gR(CUR.mainJob,CUR.mainRang)},
      {job:CUR.secondJob,rank:CUR.secondJob?gR(CUR.secondJob,CUR.secondRang):null}
    ];
    return myJobs.some(function(mj){
      if(mj.job!==rule.jobId)return false;
      return(mj.rank?(mj.rank.level||0):0)>=(rule.minLevel||0);
    });
  });
}

function applyTabVisibility(){
  if(!CUR)return;
  sh('tabLivemap',CUR.isMaster||ok('map_view'));
  if(!CUR.isMaster){
    // Master-Only Karten ausblenden
    document.querySelectorAll('.admin-card.master-only').forEach(function(el){el.style.display='none';});
    // Dok-Typen Karte: nur anzeigen wenn doc_type_manage
    var dtCard=document.querySelector('.admin-card.doc-type-card');
    if(dtCard)dtCard.style.display=ok('doc_type_manage')?'':'none';
    // Titel anpassen
    var t=document.getElementById('adminTitle');
    if(t){
      if((ok('job_manage')||ok('job_create'))&&ok('doc_type_manage'))t.textContent='Verwaltung';
      else if(ok('job_manage')||ok('job_create'))t.textContent='Berufe verwalten';
      else if(ok('doc_type_manage'))t.textContent='Dokumente verwalten';
    }
  }
}

function exportAllData(){
  var data={
    exportDate:new Date().toISOString(),
    citizens:ld('cn_citizens'),
    documents:ld('cn_documents'),
    cars:ld('cn_cars'),
    jobs:ld('cn_jobs'),
    lexikon:ld('cn_lexikon'),
    docTypes:getDocTypes()
  };
  var blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  var a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='civilnet_export_'+new Date().toISOString().slice(0,10)+'.json';
  a.click();
  toast('Export gestartet.','success');
  audit('DATA_EXPORT','Full export created');
}
</script>
</body>
</html>