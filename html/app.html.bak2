    <button class="btn btn-ghost" onclick="closeM('mStvo')">Abbrechen</button>
    <button class="btn btn-primary" id="stvoSaveBtn" onclick="saveStvo()">Speichern</button>
  </div>
</div></div>

<div class="toast-box" id="toastBox"></div>

<script>

var RES=(function(){try{var m=window.location.href.match(/cfx-nui-([^\/]+)/);if(m)return m[1];}catch(e){}return 'coastnet';})();
var SESSION=null,CUR=null,EDIT_USER=null,EDIT_JOB=null,ASSIGN_UID=null;
var DETAIL_CIT=null,DETAIL_DOC=null,DETAIL_CAR=null,DETAIL_LEX=null,DETAIL_JOB=null;
var _stvoPage=0, _docPage=0, _docSearch='';
var JC_UID=null,_confirmCb=null,rankIdx=1;
var TEMP_ACCESS_LIST=[];
var ALL_RIGHTS=['doc_create','doc_read','doc_edit','doc_delete','wanted_manage','map_view','stvo_manage','give_job','citizen_view','job_manage','doc_type_manage','job_create'];
// Rechte die NUR als Charakter-Individualrecht gelten (nicht in Rang-Rechten auftauchen)
var CHAR_ONLY_RIGHTS=['job_create'];

function askConfirm(text,cb){document.getElementById('mConfirmText').textContent=text;_confirmCb=cb;openM('mConfirm');}
function confirmResolve(yes){closeM('mConfirm');if(yes&&_confirmCb)_confirmCb();_confirmCb=null;}

window.addEventListener('load',function(){

  // job_einreise und job_arbeitslos aus gespeicherten Jobs entfernen
  var jobs = ld('cn_jobs');
  var changed = false;
  jobs = jobs.filter(function(j){ if(j.id==='job_einreise'||j.id==='job_arbeitslos'){changed=true;return false;}return true; });
  if(changed) sv('cn_jobs', jobs);


  var s=sessionStorage.getItem('cn_session');
  if(!s){
    var u=localStorage.getItem('cn_currentUser');
    if(u){
      var userObj=JSON.parse(u);
      s=JSON.stringify({id:userObj.id,username:userObj.username});
      sessionStorage.setItem('cn_session',s);
    }
  }
  if(!s){location.href='login.html';return;}
  SESSION=JSON.parse(s);CUR=gU(SESSION.id);
  if(!CUR){location.href='login.html';return;}
  document.getElementById('appLayout').style.display='flex';
  document.getElementById('topUsername').textContent=CUR.username;
  document.getElementById('topCivId').textContent=CUR.civId||'--';
  document.getElementById('topJobBadge').textContent=CUR.isMaster?'MASTER':((CUR.mainJob&&CUR.mainJob!=='job_arbeitslos'?jN(CUR.mainJob):'')||'--');
  document.getElementById('topRangBadge').textContent=CUR.isMaster?'Vollzugriff':(rN(CUR.mainJob,CUR.mainRang)||'--');
  if(CUR.isMaster)document.getElementById('topJobBadge').className='badge badge-danger';
  if(CUR.isMaster){sh('tabAdmin',true);sh('tabIds',true);sh('tabLivemap',true);}
  if(!CUR.isMaster&&(ok('job_manage')||ok('job_create')))sh('tabAdmin',true);
  if(!CUR.isMaster&&ok('doc_type_manage')){sh('tabAdmin',true);sh('btnDocTypes',true);}
  applyTabVisibility();
  // Bürger-Tab: sichtbar wenn Master oder citizen_view Recht
  if(!CUR.isMaster&&!ok('citizen_view'))document.getElementById('btnAddBürger').style.display='none';
  // Cars-Tab immer sichtbar (kein car_view Recht mehr)
  // IDs-Tab nur für Master
  if(CUR.isMaster)sh('btnAddLexikon',true);
  if(CUR.isMaster)sh('btnDocTypes',true);
  document.querySelectorAll('.modal-backdrop').forEach(function(m){
    // Kein Schließen durch Klick auf Backdrop - nur X-Button schließt
  });
  document.addEventListener('keydown',function(ev){
    // Kein ESC-Schließen
  });
  


  // ── Auto-Bereinigung: CIV-0000, Hash-Namen und Duplikate löschen ──
  (function cleanupCivZero(){
    var users = ld('cn_users');
    var before = users.length;
    users = users.filter(function(u){
      if(u.isMaster) return true;
      if(!u.civId || u.civId === '') return false;
      if(/^CIV-0+$/.test(u.civId)) return false;
      return true;
    });
    if(users.length !== before){ sv('cn_users', users); }

    var cits = ld('cn_citizens');
    var cBefore = cits.length;
    // Null-Namen, leere Namen und Hash-Identifier als Name entfernen
    cits = cits.filter(function(c){
      var n = c.name || '';
      if(!n || n === 'null' || n === 'NULL' || n === 'undefined') return false;
      if(n.length > 30 && n.indexOf(' ') === -1) return false;
      return true;
    });
    // Duplikate per Identifier entfernen (ersten behalten)
    var seenIdents = {};
    cits = cits.filter(function(c){
      if(!c.identifier) return true;
      if(seenIdents[c.identifier]) return false;
      seenIdents[c.identifier] = true;
      return true;
    });
    if(cits.length !== cBefore){ sv('cn_citizens', cits); }
  })();

  renderAll();

  setTimeout(loadFromDatabase, 800);
});


window.addEventListener('message', function(event) {
  var data = event.data;
  if (!data || !data.action) return;
  
  if (data.action === 'loadCitizens') {

    var serverCits = data.citizens || [];
    var localCits  = ld('cn_citizens');
    function dbVal(v){ return (v===null||v===undefined||v==='null'||v==='NULL'||v==='undefined') ? '' : String(v).trim(); }

    serverCits.forEach(function(sc) {
      // nr aus id ableiten wenn nicht vorhanden
      if(!sc.nr && sc.id) sc.nr = sc.id;

      // Namen bereinigen: wenn Name wie ein Hash aussieht, Vor+Nachname bevorzugen
      var fn = dbVal(sc.u_firstname), ln = dbVal(sc.u_lastname);
      var displayName = (fn && ln) ? (fn+' '+ln) : fn || ln || dbVal(sc.name) || 'Unbekannt';
      if(!displayName || (displayName.length > 30 && displayName.indexOf(' ') === -1)) {
        displayName = (fn && ln) ? (fn+' '+ln) : (dbVal(sc.name) || 'Unbekannt');
      }

      var idx = localCits.findIndex(function(lc){ return String(lc.id)===String(sc.id); });
      var entry = {
        id:           sc.id,
        nr:           sc.nr || sc.id,
        name:         displayName,
        birth:        dbVal(sc.u_dateofbirth) || dbVal(sc.birth),
        height:       dbVal(sc.u_height)      || dbVal(sc.height),
        phone:        dbVal(sc.phone),
        sex:          dbVal(sc.u_sex)         || dbVal(sc.sex) || 'M',
        firstname:    fn,
        lastname:     ln,
        jobId:        dbVal(sc.job) || null,
        rankId:       dbVal(sc.job_rank) || null,
        job:          dbVal(sc.job) || 'job_arbeitslos',
        job_rank:     dbVal(sc.job_rank) || 'rank_al_1',
        second_job:   dbVal(sc.second_job) || null,
        second_rank:  dbVal(sc.second_rank) || null,
        wanted:       !!sc.wanted,
        wanted_reason: dbVal(sc.wanted_reason),
        identifier:   dbVal(sc.identifier),
        fromDB:       true
      };
      if(idx>=0){ localCits[idx]=Object.assign(localCits[idx], entry); }
      else { localCits.push(entry); }
    });

    // Null-Namen und ungültige Einträge rausfiltern
    localCits = localCits.filter(function(c) {
      var n = c.name || '';
      if(!n) return false;
      if(n === 'null' || n === 'NULL' || n === 'undefined') return false;
      // Nur ein Wort UND länger als 30 Zeichen → wahrscheinlich ein Identifier-Hash
      if(n.length > 30 && n.indexOf(' ') === -1) return false;
      return true;
    });

    // Duplikate bereinigen: gleicher Identifier → nur einen behalten (den mit nr/id > 0)
    var seen = {};
    localCits = localCits.filter(function(c) {
      if(!c.identifier) return true;
      var key = c.identifier;
      if(seen[key]) return false;
      seen[key] = true;
      return true;
    });

    // CIV/CIT-0000 rausfiltern
    var users = ld('cn_users');
    var changed = false;
    localCits.forEach(function(cit) {
      if(!cit.identifier) return;
      var ident = cit.identifier;
      var matchedUser = users.find(function(u) {
        if(!u.identifier) return false;
        return u.identifier === ident
          || u.identifier === ident.replace('license:','')
          || 'license:'+u.identifier === ident;
      });
      if(matchedUser && matchedUser.linkedCitizenId !== cit.id) {
        matchedUser.linkedCitizenId = cit.id;
        changed = true;
      }
      if(matchedUser && cit.linkedUserId !== matchedUser.id) {
        cit.linkedUserId = matchedUser.id;
        changed = true;
      }
    });
    if(changed){ sv('cn_users', users); }

    sv('cn_citizens', localCits);
    renderCitizens(); renderIds(); renderAusweis();
    return;
  }
  if (data.action === 'loadVehicles') {
    var serverVehs = data.vehicles || [];
    var localVehs  = ld('cn_cars');
    serverVehs.forEach(function(sv2) {
      var idx = localVehs.findIndex(function(lv){ return String(lv.plate||lv.id)===String(sv2.plate||sv2.id); });
      var entry = {
        id:    sv2.id || sv2.plate,
        plate: sv2.plate || '',
        model: sv2.model || '',
        owner: sv2.owner || '',
        color: sv2.color || '',
        fromDB: true
      };
      if(idx>=0){ localVehs[idx]=Object.assign(localVehs[idx], entry); }
      else { localVehs.push(entry); }
    });
    sv('cn_cars', localVehs);
    renderCars();
    return;
  }


  if (data.action === 'refreshRequired') {
    loadFromDatabase();
    return;
  }
  if (data.action === 'loadTokens') {
    renderTokenTable(data.tokens || []);
  }
});


function loadFromDatabase() {
  fetch('https://'+RES+'/loadCitizensFromDB',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}).catch(function(){});
  fetch('https://'+RES+'/loadVehiclesFromDB',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({})}).catch(function(){});
}


function onServerRefresh() {
  loadFromDatabase();
}


function renderTokenTable(tokens) {
  var wrap = document.getElementById('tokenTableWrap');
  if (!wrap) return;
  if (!tokens || tokens.length === 0) {
    wrap.innerHTML = '<div class="empty-state"><div class="empty-icon">&#x1F511;</div><div>Keine Tokens in der Datenbank gefunden.</div></div>';
    return;
  }
  wrap.innerHTML =
    '<div class="table-wrap"><table><thead><tr>'+
    '<th>Token</th><th>Spielername (FiveM)</th><th>Bürger</th><th>Status</th><th>Genutzt von</th><th>Erstellt</th><th>Genutzt am</th></tr></thead><tbody>'+
    tokens.map(function(t) {
      var statusBadge = t.used
        ? '<span class="badge badge-green">Genutzt</span>'
        : '<span class="badge badge-muted">Offen</span>';
      return '<tr>'+
        '<td style="font-family:monospace;color:var(--accent);letter-spacing:.1em">'+ec(t.token||'--')+'</td>'+
        '<td>'+ec(t.player_name||'--')+'</td>'+
        '<td style="color:var(--text2)">'+ec(t.citizen_name||'--')+'</td>'+
        '<td>'+statusBadge+'</td>'+
        '<td>'+ec(t.used_by_username||'--')+'</td>'+
        '<td style="font-size:.68rem;color:var(--muted)">'+
          (t.created_at ? new Date(t.created_at).toLocaleString('de-DE') : '--')+'</td>'+
        '<td style="font-size:.68rem;color:var(--muted)">'+
          (t.used_at ? new Date(t.used_at).toLocaleString('de-DE') : '--')+'</td>'+
        '</tr>';
    }).join('')+
    '</tbody></table></div>';
}


function loadTokensFromServer() {
  try {
    fetch('https://'+RES+'/loadTokensFromDB', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({})
    }).catch(function() {});
  } catch(e) {
    console.warn('[COASTNET] Could not load tokens:', e);
  }
}

function mergeCitizensFromDatabase(dbBürgers) {

}

function mergeVehiclesFromDatabase(dbVehicles) {

}

function ld(k){return JSON.parse(localStorage.getItem(k)||'[]');}
function sv(k,v){localStorage.setItem(k,JSON.stringify(v));}
function gU(id){return ld('cn_users').find(function(u){return u.id===id;})||null;}
function gJ(id){return ld('cn_jobs').find(function(j){return j.id===id;})||null;}
function jN(id){var j=gJ(id);return j?j.name:null;}
function gR(jid,rid){var j=gJ(jid);return j?(j.ranks.find(function(r){return r.id===rid;})||null):null;}
function rN(jid,rid){var r=gR(jid,rid);return r?r.name:null;}
function cN(id){var c=ld('cn_citizens').find(function(c){return String(c.id)===String(id);});return c?c.name:'--';}
function nId(){var c=parseInt(localStorage.getItem('cn_id_counter')||'2000');localStorage.setItem('cn_id_counter',String(c+1));return c;}
function ec(s){if(s===null||s===undefined||s==='null'||s==='undefined'||s==='NULL')return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
// null-safe display: zeigt '--' bei null/undefined/leeren Werten
function nd(v,suffix){if(v===null||v===undefined||v==='null'||v==='NULL'||v===''||v==='undefined')return'--';return ec(v)+(suffix||'');}
function td(){return new Date().toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'});}
function ok(r){
  if(!CUR)return false;if(CUR.isMaster)return true;
  var r1=gR(CUR.mainJob,CUR.mainRang),r2=CUR.secondJob?gR(CUR.secondJob,CUR.secondRang):null;
  return(r1&&r1.rights||[]).indexOf(r)>=0||(r2&&r2.rights||[]).indexOf(r)>=0||(CUR.rights||[]).indexOf(r)>=0;
}
function getDocAccessLevel(){
  if(!CUR)return 0;if(CUR.isMaster)return 5;
  var r1=gR(CUR.mainJob,CUR.mainRang),r2=CUR.secondJob?gR(CUR.secondJob,CUR.secondRang):null;
  var level1=(r1&&r1.docAccessLevel)||0,level2=(r2&&r2.docAccessLevel)||0;
  return Math.max(level1,level2);
}
function audit(a,d){var logs=ld('cn_audit');logs.unshift({action:a,userId:SESSION&&SESSION.id,username:SESSION&&SESSION.username,detail:d,ts:new Date().toISOString()});if(logs.length>500)logs.splice(500);sv('cn_audit',logs);}
function toast(msg,type){var c=document.getElementById('toastBox'),t=document.createElement('div');t.className='toast '+(type||'info');t.textContent=msg;c.appendChild(t);setTimeout(function(){t.remove();},3200);}
function openM(id){document.getElementById(id).classList.add('open');}
function closeM(id){document.getElementById(id).classList.remove('open');}
function sh(id,show){var b=document.getElementById(id);if(b)b.classList.toggle('hidden',!show);}
function showTab(n){
  var layout=document.getElementById('appLayout');
  document.querySelectorAll('.tab-content').forEach(function(t){t.classList.remove('active');t.style.display='';t.style.height='';t.style.overflow='';});
  document.querySelectorAll('.tab-btn').forEach(function(b){b.classList.remove('active');});
  var tc=document.getElementById('tab-'+n);
  if(tc){
    tc.classList.add('active');
    if(n==='livemap'){
      tc.style.display='flex';tc.style.flexDirection='column';
      tc.style.height='calc(100vh - 56px - 48px)';
      tc.style.overflow='hidden';
      if(layout){layout.style.overflow='hidden';layout.style.height='100vh';}
    } else {
      if(layout){layout.style.overflow='';layout.style.height='';}
    }
  }
  var tb=document.querySelector('[data-tab="'+n+'"]');if(tb)tb.classList.add('active');
}
function doLogout(){audit('LOGOUT','logged out');sessionStorage.removeItem('cn_session');localStorage.removeItem('cn_currentUser');sessionStorage.setItem('cn_manual_logout','1');location.replace('login.html');}


var _livemapInited=false;
function initLivemap(){
  if(_livemapInited)return;
  _livemapInited=true;

  window.addEventListener('message',function(ev){
    var lf=document.getElementById('livemapFrame');
    if(!lf||!ev.data||!ev.data.action)return;
    if(ev.data.action==='liveMapPlayers'||ev.data.action==='liveMapUpdate'||ev.data.action==='liveMapRemove'){
      try{lf.contentWindow.postMessage(ev.data,'*');}catch(e){}
    }
  });
}
function renderAll(){renderAusweis();renderCitizens();renderDocs();renderCars();renderLexikon();renderIds();updateWantedBadge();}

function renderAusweis(){
  CUR=gU(SESSION.id);
  var el=document.getElementById('ausweisCard');

  // Master bekommt den alten Ausweis
  if(CUR.isMaster){
    el.innerHTML=
      '<div style="background:var(--panel);border:1px solid var(--border2);border-top:3px solid var(--danger);padding:28px;max-width:480px">'+
      '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">'+
      '<div><div style="font-size:.6rem;color:var(--muted);letter-spacing:.2em;text-transform:uppercase;margin-bottom:4px">Master Account</div>'+
      '<div style="font-family:serif;font-size:2rem;color:var(--danger);letter-spacing:.1em">'+ec(CUR.civId||'--')+'</div></div></div>'+
      '<div class="detail-grid" style="grid-template-columns:1fr 1fr;gap:14px">'+
      '<div class="detail-field"><div class="detail-label">IC-Name</div><div class="detail-value">'+ec(CUR.username)+'</div></div>'+
      '<div class="detail-field"><div class="detail-label">Rolle</div><div class="detail-value"><span class="badge badge-danger">MASTER</span></div></div>'+
      '<div class="detail-field"><div class="detail-label">Vollzugriff</div><div class="detail-value">Alle Rechte</div></div>'+
      '<div class="detail-field"><div class="detail-label">Registriert</div><div class="detail-value">'+new Date(CUR.createdAt||Date.now()).toLocaleDateString('de-DE')+'</div></div>'+
      '</div></div>';
    return;
  }

  // Citizen aus linkedCitizenId oder per Identifier suchen
  var lc=CUR.linkedCitizenId?ld('cn_citizens').find(function(c){return String(c.id)===String(CUR.linkedCitizenId);}):null;
  if(!lc && CUR.identifier){
    lc=ld('cn_citizens').find(function(c){
      return c.identifier&&(c.identifier===CUR.identifier||c.identifier===CUR.identifier.replace('license:',''));
    });
  }

  if(!lc){
    el.innerHTML='<div style="background:var(--panel);border:1px solid var(--border2);border-top:3px solid var(--danger);padding:28px;max-width:520px">'+
      '<div style="font-size:.6rem;color:var(--muted);letter-spacing:.2em;text-transform:uppercase;margin-bottom:16px">Mein Ausweis</div>'+
      '<div style="color:var(--muted);font-size:.82rem">Kein verknüpfter Charakter gefunden. Bitte wende dich an einen Admin.</div></div>';
    return;
  }

  var fn=lc.firstname||'', ln=lc.lastname||'';
  if(!fn&&!ln){ var parts=(lc.name||'').split(' '); fn=parts[0]||''; ln=parts.slice(1).join(' ')||''; }
  var birth=lc.birth||'--';
  var height=lc.height?(lc.height+' cm'):'--';
  var sex=lc.sex?({'M':'Männlich','F':'Weiblich','m':'Männlich','f':'Weiblich','male':'Männlich','female':'Weiblich'}[lc.sex]||lc.sex):'--';

  // Jobs — nur anzeigen wenn gesetzt und nicht job_arbeitslos
  function jobField(label,jid,rid){
    if(!jid||jid==='job_arbeitslos')return '';
    var jname=jN(jid)||jid; var rname=rN(jid,rid)||'--';
    return'<div class="detail-field"><div class="detail-label">'+label+'</div>'+
      '<div class="detail-value"><span class="badge badge-muted" style="margin-right:6px">'+ec(jname)+'</span><span style="color:var(--muted);font-size:.72rem">'+ec(rname)+'</span></div></div>';
  }

  var job1id=lc.jobId||lc.job;var rank1id=lc.rankId||lc.job_rank;
  var job2id=lc.secondJobId||lc.second_job;var rank2id=lc.secondRangId||lc.second_rank;
  var job3id=lc.thirdJobId||lc.third_job;var rank3id=lc.thirdRangId||lc.third_rank;

  var hasAnyJob=(job1id&&job1id!=='job_arbeitslos')||(job2id&&job2id!=='job_arbeitslos')||(job3id&&job3id!=='job_arbeitslos');
  var jobsHTML=jobField('Hauptberuf',job1id,rank1id)+
    jobField('Zweitberuf',job2id,rank2id)+
    jobField('Drittberuf',job3id,rank3id);

  // Wenn kein Job → "Unemployed" anzeigen
  if(!hasAnyJob){
    jobsHTML='<div class="detail-field"><div class="detail-label">Beruf</div><div class="detail-value" style="color:var(--muted)">Unemployed</div></div>';
  }

  el.innerHTML=
    '<div style="background:var(--panel);border:1px solid var(--border2);border-top:3px solid var(--danger);padding:28px;max-width:520px">'+
    '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px">'+
    '<div><div style="font-size:.6rem;color:var(--muted);letter-spacing:.2em;text-transform:uppercase;margin-bottom:4px">Mein Ausweis</div>'+
    '<div style="font-family:serif;font-size:2rem;color:var(--danger);letter-spacing:.1em">CIT-'+String(lc.nr||lc.id||0).padStart(4,'0')+'</div></div></div>'+
    '<div class="detail-grid" style="grid-template-columns:1fr 1fr;gap:14px;margin-bottom:20px">'+
    '<div class="detail-field"><div class="detail-label">Vorname</div><div class="detail-value">'+ec(fn||'--')+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Nachname</div><div class="detail-value">'+ec(ln||'--')+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Geburtsdatum</div><div class="detail-value">'+ec(birth)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Geschlecht</div><div class="detail-value">'+ec(sex)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Größe</div><div class="detail-value">'+ec(height)+'</div></div>'+
    '</div>'+
    '<hr class="detail-divider" style="margin-bottom:14px"/>'+
    '<div class="detail-grid" style="grid-template-columns:1fr;gap:10px">'+jobsHTML+'</div>'+
    '</div>';
}

function openJobChange(uid){
  JC_UID=uid;var u=gU(uid);
  document.getElementById('jobChangeInfo').innerHTML='Job change for: <strong>'+ec(u.username)+'</strong> ('+ec(u.civId||'--')+')<br>Aktuell: '+ec((u.mainJob&&u.mainJob!=='job_arbeitslos'?jN(u.mainJob):'')||'--')+' / '+ec(rN(u.mainJob,u.mainRang)||'--');
  var jSel=document.getElementById('jcJob');
  jSel.innerHTML='<option value="">-- Beruf auswählen --</option>'+
    ld('cn_jobs').filter(function(j){return!j.isSecondJob;}).map(function(j){return'<option value="'+j.id+'"'+(j.id===u.mainJob?' selected':'')+'>'+ec(j.name)+'</option>';}).join('');
  document.getElementById('jcRangGrp').classList.add('hidden');
  updateJCRang(u.mainRang);
  openM('mJobChange');
}
function updateJCRang(selRang){
  var jid=document.getElementById('jcJob').value,grp=document.getElementById('jcRangGrp'),rSel=document.getElementById('jcRang');
  if(!jid){grp.classList.add('hidden');return;}
  var j=gJ(jid);if(!j||!j.ranks.length){grp.classList.add('hidden');return;}
  rSel.innerHTML=j.ranks.map(function(r){return'<option value="'+r.id+'"'+(r.id===selRang?' selected':'')+'>'+ec(r.name)+' (Lv.'+r.level+')</option>';}).join('');
  grp.classList.remove('hidden');
}
function saveJobChange(){
  var jid=document.getElementById('jcJob').value,rid=document.getElementById('jcRang').value;
  if(!jid){toast('Bitte einen Beruf auswählen!','error');return;}
  var users=ld('cn_users'),i=users.findIndex(function(u){return u.id===JC_UID;});
  if(i<0)return;
  users[i].mainJob=jid;users[i].mainRang=rid||null;sv('cn_users',users);
  audit('JOB_CHANGE','Job: '+users[i].username+' -> '+jN(jid));
  if(JC_UID===CUR.id){CUR=gU(CUR.id);document.getElementById('topJobBadge').textContent=(CUR.mainJob&&CUR.mainJob!=='job_arbeitslos'?jN(CUR.mainJob):'')||'--';document.getElementById('topRangBadge').textContent=rN(CUR.mainJob,CUR.mainRang)||'--';}
  closeM('mJobChange');renderAusweis();toast('Beruf geändert: '+jN(jid),'success');
}

function renderIds(){
  if(!CUR.isMaster)return;
  var list=document.getElementById('idList'),q=(document.getElementById('idSearch').value||'').toLowerCase();
  var users=ld('cn_users');
  if(q)users=users.filter(function(u){return u.username.toLowerCase().indexOf(q)>=0||(u.civId||'').toLowerCase().indexOf(q)>=0;});
  document.getElementById('idCount').textContent=users.length+' IDs';
  if(!users.length){list.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1FAA7;</div><div>Keine IDs</div></div>';return;}
  var canA=CUR.isMaster;
  list.innerHTML=users.map(function(u){
    var lc=u.linkedCitizenId?ld('cn_citizens').find(function(c){return String(c.id)===String(u.linkedCitizenId);}):null;
    return'<div class="card" style="cursor:default">'+
      '<div class="card-left" style="gap:16px">'+
      '<div style="font-family:monospace;font-size:.9rem;color:var(--danger);font-weight:600">'+ec(u.civId||'--')+'</div>'+
      '<div><div class="card-title">'+ec(u.username)+(u.isMaster?' <span class="badge badge-danger">Master</span>':'')+'</div>'+
      '<div style="font-size:.65rem;color:var(--muted);margin-top:2px">'+ec((u.mainJob&&u.mainJob!=='job_arbeitslos'?jN(u.mainJob):'')||'--')+'</div></div></div>'+
      '<div class="card-right">'+
      (lc?'<span class="badge badge-green">-> '+ec(lc.name)+'</span>':'<span class="badge badge-muted">Nicht zugewiesen</span>')+
      (canA&&!u.isMaster?'<button class="btn btn-primary btn-sm" onclick="openIdAssign(\''+u.id+'\')">Zuweisen</button>':'')+
      '</div></div>';
  }).join('');
}
function openIdAssign(uid){
  ASSIGN_UID=uid;var u=gU(uid);
  document.getElementById('idAssignInfo').innerHTML=
    '<div style="display:flex;gap:14px;align-items:center"><div style="font-family:monospace;font-size:1.1rem;color:var(--danger);font-weight:600">'+ec(u.civId)+'</div>'+
      '<div><div style="font-size:.9rem;color:var(--text)">'+ec(u.username)+'</div><div style="font-size:.65rem;color:var(--muted)">'+ec((u.mainJob&&u.mainJob!=='job_arbeitslos'?jN(u.mainJob):'')||'--')+'</div></div></div>'+
    (u.linkedCitizenId?'<div style="margin-top:8px;font-size:.72rem;color:var(--accent)">Aktuell: '+ec(cN(u.linkedCitizenId))+'</div>':'');
  var sel=document.getElementById('idAssignCit');
  sel.innerHTML='<option value="">-- Bürger auswählen --</option>'+
    ld('cn_citizens').map(function(c){return'<option value="'+c.id+'"'+(c.id===u.linkedCitizenId?' selected':'')+'>'+ec(c.name)+' (CIT-'+String(c.nr||c.id||0).padStart(4,'0')+')</option>';}).join('');
  openM('mIdAssign');
}
function saveIdAssign(){
  var cid=document.getElementById('idAssignCit').value;
  if(!cid){toast('Bitte einen Bürger auswählen!','error');return;}
  var users=ld('cn_users'),ui=users.findIndex(function(u){return u.id===ASSIGN_UID;});if(ui<0)return;
  var old=users[ui].linkedCitizenId;users[ui].linkedCitizenId=cid;sv('cn_users',users);
  var cits=ld('cn_citizens'),ci=cits.findIndex(function(c){return String(c.id)===String(cid);});
  if(ci>=0){cits[ci].linkedUserId=ASSIGN_UID;sv('cn_citizens',cits);}
  if(old&&old!==cid){var oi=cits.findIndex(function(c){return String(c.id)===String(old);});if(oi>=0&&cits[oi].linkedUserId===ASSIGN_UID){cits[oi].linkedUserId=null;sv('cn_citizens',cits);}}
  audit('ID_ASSIGN',users[ui].civId+' -> '+cN(cid));
  if(ASSIGN_UID===CUR.id){CUR=gU(CUR.id);renderAusweis();}
  closeM('mIdAssign');renderIds();renderCitizens();toast(users[ui].civId+' -> '+cN(cid)+' zugewiesen.','success');
}

function renderCitizens(){
  if(!CUR.isMaster&&!ok('citizen_view')){
    var list=document.getElementById('citizenList');
    if(list)list.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1F512;</div><div>Keine Berechtigung</div></div>';
    document.getElementById('citizenCount').textContent='0 Bürger';
    return;
  }
  var list=document.getElementById('citizenList'),q=(document.getElementById('citizenSearch').value||'').toLowerCase();
  var arr=ld('cn_citizens');
  if(q)arr=arr.filter(function(c){return c.name.toLowerCase().indexOf(q)>=0;});
  document.getElementById('citizenCount').textContent=arr.length+' Bürger';
  if(!arr.length){list.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1F464;</div><div>Keine Bürger vorhanden</div></div>';return;}
  list.innerHTML=arr.map(function(c){
    var lu=c.linkedUserId?gU(c.linkedUserId):null;
   
    var wantedBadge = '';
    if(c.wanted === true) {
      wantedBadge = ' <span class="badge badge-danger" style="font-weight:600;font-size:.65rem;margin-left:8px;vertical-align:middle">GESUCHT</span>';
    }
    return'<div class="card" onclick="openCitizenDetail(\''+c.id+'\')" style="'+(c.wanted?'border-left:3px solid var(--danger);':'')+'">' +
      '<div class="card-left"><div class="card-id">CIT-'+String(c.nr||c.id||0).padStart(4,'0')+'</div>'+
      '<div class="card-label" style="'+(c.wanted?'color:var(--danger)':'')+'">'+(c.wanted?'GESUCHT':'Bürger')+'</div>'+
      '<div class="card-title">'+ec(c.name)+wantedBadge+'</div></div>'+
      '<div class="card-right">'+
      (lu?'<span class="badge badge-accent">'+ec(lu.civId)+'</span>':'<span class="badge badge-muted">Kein Ausweis</span>')+
      ((c.stvoPunkte&&c.stvoPunkte>0)?'<span class="badge badge-accent">'+c.stvoPunkte+' Pkt.</span>':'')+
      '<span class="card-meta">'+nd(jN(c.jobId))+'</span><span class="card-arrow">&#x203A;</span></div></div>';
  }).join('');
}
function openCitizenModal(editId){
  if(!CUR.isMaster&&!ok('citizen_view')){toast('Keine Berechtigung!','error');return;}
  document.getElementById('cEditId').value=editId||'';
  document.getElementById('mCitizenTitle').textContent=editId?'Bürger bearbeiten':'Person hinzufügen';
  var uSel=document.getElementById('cLinked');
  uSel.innerHTML='<option value="">-- kein Account --</option>'+ld('cn_users').filter(function(u){return!u.isMaster;}).map(function(u){return'<option value="'+u.id+'">'+ec(u.civId)+' -- '+ec(u.username)+'</option>';}).join('');
  if(editId){var c=ld('cn_citizens').find(function(c){return String(c.id)===String(editId);});document.getElementById('cName').value=c.name||'';document.getElementById('cBirth').value=c.birth||'';document.getElementById('cHeight').value=c.height||'';document.getElementById('cTelefon').value=c.phone||'';uSel.value=c.linkedUserId||'';}
  else{['cName','cBirth','cHeight','cTelefon'].forEach(function(f){document.getElementById(f).value='';});uSel.value='';}
  openM('mCitizen');
}
function saveCitizen(){
  var name=document.getElementById('cName').value.trim();if(!name){toast('Name ist erforderlich!','error');return;}
  var birth=document.getElementById('cBirth').value,height=document.getElementById('cHeight').value,
      phone=document.getElementById('cTelefon').value.trim(),
      linkUid=document.getElementById('cLinked').value,
      editId=document.getElementById('cEditId').value;
  var cits=ld('cn_citizens');
  if(editId){var i=cits.findIndex(function(c){return c.id===editId;});if(i>=0){cits[i].name=name;cits[i].birth=birth;cits[i].height=height;cits[i].phone=phone;cits[i].linkedUserId=linkUid||null;cits[i].updatedAt=new Date().toISOString();}audit('CITIZEN_EDIT','Bürger bearbeitet: '+name);}
  else{var nr=nId();cits.unshift({id:'cit_'+nr,nr:nr,name:name,birth:birth,height:height,phone:phone,linkedUserId:linkUid||null,createdAt:new Date().toISOString()});audit('CITIZEN_CREATE','Neuer Bürger: '+name);}
  sv('cn_citizens',cits);
  if(linkUid){var users=ld('cn_users'),ui=users.findIndex(function(u){return u.id===linkUid;});if(ui>=0){users[ui].linkedCitizenId=editId||cits[0].id;sv('cn_users',users);}}
  var savedCit=editId?cits[cits.findIndex(function(c){return String(c.id)===String(editId);})]:(cits[0]||null);
  if(savedCit){fetch('https://'+RES+'/saveCitizen',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({citizen:savedCit})}).catch(function(){});}
  renderCitizens();closeM('mCitizen');toast(editId?'Bürger aktualisiert.':'Bürger erstellt.','success');
}
function syncRights(uid,jid,rid,jobType){
  var users=ld('cn_users'),i=users.findIndex(function(u){return u.id===uid;});if(i<0)return;
  var cits=ld('cn_citizens'),ci=cits.findIndex(function(c){return c.linkedUserId===uid;});
  // Alle 3 Jobs vom Citizen auf den User übertragen
  if(ci>=0){
    var cit=cits[ci];
    users[i].mainJob=cit.jobId||cit.job||null;
    users[i].mainRang=cit.rankId||cit.job_rank||null;
    users[i].secondJob=cit.secondJobId||cit.second_job||null;
    users[i].secondRang=cit.secondRangId||cit.second_rank||null;
    users[i].thirdJob=cit.thirdJobId||cit.third_job||null;
    users[i].thirdRang=cit.thirdRangId||cit.third_rank||null;
  } else if(jid){
    users[i].mainJob=jid;users[i].mainRang=rid;
  }
  sv('cn_users',users);
  if(uid===CUR.id){
    CUR=gU(CUR.id);
    renderAusweis();
    document.getElementById('topJobBadge').textContent=jN(CUR.mainJob)||'--';
    document.getElementById('topRangBadge').textContent=rN(CUR.mainJob,CUR.mainRang)||'--';
  }
  audit('SYNC_RIGHTS','Rechte sync: '+(gU(uid)&&gU(uid).username)+' -> '+jN(jid||users[i].mainJob));
}
function openCitizenDetail(id){
  // Zugriffsprüfung Bürgerprofil
  if(!CUR.isMaster && !canAccessProfile(id)){
    toast('Kein Zugriff auf Bürgerprofile.','error');return;
  }
  var prevId = DETAIL_CIT;
  DETAIL_CIT=id;var c=ld('cn_citizens').find(function(c){return String(c.id)===String(id);});if(!c)return;
  if(prevId !== id){ _stvoPage=0; _docPage=0; _docSearch=''; }
  var lu=c.linkedUserId?gU(c.linkedUserId):null;
  var jn=c.jobId?(jN(c.jobId)||'--'):'--',rn=(c.jobId&&c.rankId)?(rN(c.jobId,c.rankId)||'--'):'--';
  var jn2=c.secondJobId?(jN(c.secondJobId)||'--'):null;
  var rn2=(c.secondJobId&&c.secondRangId)?(rN(c.secondJobId,c.secondRangId)||'--'):null;
  var jn3=c.thirdJobId?(jN(c.thirdJobId)||'--'):null;
  var rn3=(c.thirdJobId&&c.thirdRangId)?(rN(c.thirdJobId,c.thirdRangId)||'--'):null;
  var hasImmigrationVerification=false; // entfernt
  var docs=ld('cn_documents').filter(function(d){return String(d.citizenId)===String(id);});
  var isWanted=c.wanted||false;
  var canManageWanted=CUR.isMaster||ok('wanted_manage');
  var canChangeJob=false; // Beruf wechseln entfernt
  var canAssignJobs=CUR.isMaster||ok('give_job');

  // ── Wanted-Banner ──
  var wantedBanner = isWanted
    ? '<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(190,6,6,.12);border:1px solid rgba(190,6,6,.35);margin-bottom:14px">'
        +'<span style="font-size:1.1rem">&#x26A0;</span>'
        +'<div><div style="font-size:.72rem;font-weight:700;color:var(--danger);letter-spacing:.1em;text-transform:uppercase">Gesucht</div>'
        +'<div style="font-size:.75rem;color:var(--text2);margin-top:2px">'+(c.wantedReason?ec(c.wantedReason):'Kein Grund angegeben')
        +(c.wantedBy?' &bull; Beamter: '+ec(c.wantedBy):'')
        +(c.wantedDate?' &bull; Seit: '+new Date(c.wantedDate).toLocaleDateString('de-DE'):'')+'</div></div>'
        +(canManageWanted?'<button class="btn btn-ghost btn-sm" style="margin-left:auto;flex-shrink:0" onclick="toggleWanted(\''+id+'\',false)">Entfernen</button>':'')
      +'</div>'
    : '';

  // ── Tab: Infos ──
  var fullName = (c.firstname && c.lastname)
    ? nd(c.firstname)+' '+nd(c.lastname)
    : ec(c.name);
  var sexLabel = !c.sex ? '--' : (c.sex === 'f' || c.sex === 'F' || c.sex === 'w' || c.sex === 'W' ? 'Weiblich' : 'Männlich');

  var tabInfos =
    '<div class="detail-grid">'
    +'<div class="detail-field"><div class="detail-label">Vorname</div><div class="detail-value">'+nd(c.firstname)+'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Nachname</div><div class="detail-value">'+nd(c.lastname)+'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Geburtsdatum</div><div class="detail-value">'+nd(c.birth)+'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Geschlecht</div><div class="detail-value">'+sexLabel+'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Größe</div><div class="detail-value">'+nd(c.height,'&nbsp;cm')+'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Telefon</div><div class="detail-value">'+nd(c.phone)+'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Beruf</div><div class="detail-value">'
    +'<span class="badge badge-accent">'+nd(jn)+'</span>'
    +(canAssignJobs&&c.jobId?'<button class="btn btn-danger btn-sm" onclick="fireMainJobFromCitizen(\''+id+'\')" style="margin-left:8px;padding:2px 8px;font-size:.65rem">Kündigen</button>':'')
    +'</div></div>'
    +'<div class="detail-field"><div class="detail-label">Rang</div><div class="detail-value">'+nd(rn)+'</div></div>'
    +'</div>'
    +'<hr class="detail-divider"/>'
    // Weitere Jobs
    +'<div style="margin-bottom:14px"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><div class="detail-label">Weitere Berufe</div>'
    +(canAssignJobs?'<button class="btn btn-ghost btn-sm" onclick="openAddJobToCitizen(\''+id+'\')" style="padding:2px 8px;font-size:.7rem">+ Hinzufügen</button>':'')
    +'</div>'
    +(jn2?'<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:var(--panel2);border:1px solid var(--border);margin-bottom:4px;border-radius:4px">'
      +'<div><span style="font-size:.75rem;color:var(--muted)">2. Beruf:</span> <span class="badge badge-accent">'+ec(jn2)+'</span> <span style="font-size:.7rem;color:var(--muted)">('+nd(rn2)+')</span></div>'
      +(canAssignJobs?'<button class="btn btn-danger btn-sm" onclick="removeJobFromCitizen(\''+id+'\',\'second\')" style="padding:2px 6px;font-size:.65rem">X</button>':'')
    +'</div>':'')
    +(jn3?'<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:var(--panel2);border:1px solid var(--border);margin-bottom:4px;border-radius:4px">'
      +'<div><span style="font-size:.75rem;color:var(--muted)">3. Beruf:</span> <span class="badge badge-accent">'+ec(jn3)+'</span> <span style="font-size:.7rem;color:var(--muted)">('+nd(rn3)+')</span></div>'
      +(canAssignJobs?'<button class="btn btn-danger btn-sm" onclick="removeJobFromCitizen(\''+id+'\',\'third\')" style="padding:2px 6px;font-size:.65rem">X</button>':'')
    +'</div>':'')
    +'</div>'
    +'<hr class="detail-divider"/>'
    // Wanted-Button
    +(canManageWanted&&!isWanted?'<div style="margin-bottom:14px"><button class="btn btn-danger btn-sm" onclick="toggleWanted(\''+id+'\',true)">Als gesucht markieren</button></div><hr class="detail-divider"/>':'')
    // Verknüpfter Account
    +'<div class="detail-label" style="margin-bottom:6px">Verknüpfter Account</div>'
    +'<div style="margin-bottom:14px">'+(lu?'<span class="badge badge-danger" style="margin-right:8px">'+ec(lu.civId)+'</span>'+ec(lu.username):'<span style="color:var(--muted);font-size:.82rem">Kein Account</span>')+'</div>'
    +'';

  // ── Tab: Aktivität ──
  var stvoSection = buildStvoSection(c);

  // Dokumente mit Suche + Pagination
  var docsFiltered = _docSearch
    ? docs.filter(function(d){ return (d.title||'').toLowerCase().indexOf(_docSearch)>=0 || (d.type||'').toLowerCase().indexOf(_docSearch)>=0; })
    : docs;
  var perPageDoc = 10;
  var totalDocPages = Math.max(1, Math.ceil(docsFiltered.length / perPageDoc));
  if(_docPage >= totalDocPages) _docPage = 0;
  var docsPage = docsFiltered.slice(_docPage * perPageDoc, (_docPage+1) * perPageDoc);

  var docsHtml = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">'
    + '<div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em">Dokumente ('+docsFiltered.length+')</div>'
    + '</div>'
    + '<div style="display:flex;align-items:center;gap:6px;margin-bottom:10px;background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:6px 10px">'
    + '<span style="color:var(--muted);font-size:.85rem">&#x1F50D;</span>'
    + '<input id="cdDocSearch" type="text" value="'+ec(_docSearch)+'" placeholder="Dokumente durchsuchen..." oninput="cdDocSearchChange(\''+id+'\',this.value)" style="background:none;border:none;outline:none;font-size:.75rem;color:var(--text);flex:1;font-family:inherit"/>'
    + (_docSearch ? '<button onclick="cdDocSearchChange(\''+id+'\',\'\')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:.8rem;padding:0">✕</button>' : '')
    + '</div>'
    + '<div class="card-list">'+(docsFiltered.length===0
      ? '<div style="color:var(--muted);font-size:.75rem;padding:6px 0">'+(docs.length===0?'Keine Dokumente vorhanden':'Keine Dokumente gefunden')+'</div>'
      : docsPage.map(function(d){
          return '<div class="card" style="cursor:default"><div class="card-left"><div class="card-label">'+ec(d.type)+'</div><div class="card-title">'+ec(d.title)+'</div></div>'
            +'<div class="card-right"><span class="card-meta">'+ec(d.date)+'</span><button class="btn btn-ghost btn-sm" onclick="closeM(\'mCitizenDetail\');openDocDetail(\''+d.id+'\')">Ansehen</button></div></div>';
        }).join(''))
    + '</div>'
    + (docsFiltered.length > perPageDoc
        ? '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;font-size:.65rem;color:var(--muted)">'
            + '<button class="btn btn-ghost btn-sm" style="font-size:.6rem;padding:2px 8px" '
              + (_docPage > 0 ? 'onclick="docChangePage('+(_docPage-1)+',\''+id+'\')"' : 'disabled style="opacity:.3"')
              + '>&#8592; Zurück</button>'
            + '<span>Seite '+(_docPage+1)+' / '+totalDocPages+'</span>'
            + '<button class="btn btn-ghost btn-sm" style="font-size:.6rem;padding:2px 8px" '
              + (_docPage < totalDocPages-1 ? 'onclick="docChangePage('+(_docPage+1)+',\''+id+'\')"' : 'disabled style="opacity:.3"')
              + '>Weiter &#8594;</button>'
          + '</div>'
        : '');

  var tabAktivitaet = stvoSection + '<hr class="detail-divider"/>' + docsHtml;

  // ── Tab-Wrapper ──
  var html = wantedBanner
    // Tab-Buttons
    +'<div style="display:flex;border-bottom:1px solid var(--border);margin-bottom:16px">'
      +'<button id="cdTab_infos" onclick="cdSwitchTab(\'infos\')" style="padding:8px 18px;background:none;border:none;border-bottom:2px solid var(--accent);color:var(--accent);font-size:.78rem;font-weight:600;cursor:pointer;letter-spacing:.06em">Infos</button>'
      +'<button id="cdTab_akt" onclick="cdSwitchTab(\'akt\')" style="padding:8px 18px;background:none;border:none;border-bottom:2px solid transparent;color:var(--muted);font-size:.78rem;cursor:pointer;letter-spacing:.06em">Aktivität</button>'
    +'</div>'
    +'<div id="cdPane_infos">'+tabInfos+'</div>'
    +'<div id="cdPane_akt" style="display:none">'+tabAktivitaet+'</div>';

  document.getElementById('mCDTitle').innerHTML='<span style="color:var(--danger)">CIT-'+String(c.nr||c.id||0).padStart(4,'0')+'</span> '+fullName+(isWanted?' <span class="badge badge-danger">GESUCHT</span>':'');
  document.getElementById('mCDBody').innerHTML=html;

  sh('mCDEditBtn',CUR.isMaster);sh('mCDDelBtn',CUR.isMaster);
  document.getElementById('mCDEditBtn').onclick=function(){closeM('mCitizenDetail');openCitizenModal(id);};
  document.getElementById('mCDDelBtn').onclick=function(){
    var name=c.name;
    askConfirm('Bürger "'+name+'" wirklich löschen?',function(){
      sv('cn_citizens',ld('cn_citizens').filter(function(x){return String(x.id)!==String(DETAIL_CIT);}));
      audit('CITIZEN_DELETE','Bürger gelöscht: '+name);
      closeM('mCitizenDetail');renderCitizens();toast('Bürger gelöscht.','error');
    });
  };
  openM('mCitizenDetail');
}

function cdSwitchTab(tab){
  var isInfos = tab==='infos';
  document.getElementById('cdPane_infos').style.display = isInfos?'':'none';
  document.getElementById('cdPane_akt').style.display   = isInfos?'none':'';
  var tI=document.getElementById('cdTab_infos'), tA=document.getElementById('cdTab_akt');
  tI.style.borderBottomColor = isInfos?'var(--accent)':'transparent';
  tI.style.color = isInfos?'var(--accent)':'var(--muted)';
  tI.style.fontWeight = isInfos?'600':'400';
  tA.style.borderBottomColor = isInfos?'transparent':'var(--accent)';
  tA.style.color = isInfos?'var(--muted)':'var(--accent)';
  tA.style.fontWeight = isInfos?'400':'600';
}

function docChangePage(page, citId) {
  _docPage = page;
  openCitizenDetail(citId);
  setTimeout(function(){ cdSwitchTab('akt'); }, 10);
}

function cdDocSearchChange(citId, val) {
  _docSearch = (val||'').toLowerCase().trim();
  _docPage = 0;
  openCitizenDetail(citId);
  setTimeout(function(){
    cdSwitchTab('akt');
    var el = document.getElementById('cdDocSearch');
    if(el){ el.focus(); el.setSelectionRange(el.value.length, el.value.length); }
  }, 10);
}

var _wantedTargetId=null;
function toggleWanted(citId,setWanted){
  var cits=ld('cn_citizens'),i=cits.findIndex(function(c){return String(c.id)===String(citId);});
  if(i<0)return;
  if(setWanted){
    _wantedTargetId=citId;
    document.getElementById('wantedReasonInput').value='';
    openM('mWantedReason');
    setTimeout(function(){document.getElementById('wantedReasonInput').focus();},100);
  }else{
    cits[i].wanted=false;cits[i].wantedReason=null;cits[i].wantedDate=null;cits[i].wantedBy=null;
    sv('cn_citizens',cits);
  audit('WANTED_REMOVE',cits[i].name+' removed from wanted');
  toast('Gesucht-Status entfernt.','success');
    renderCitizens();
    openCitizenDetail(citId);
    updateWantedBadge();
  }
}
function confirmWanted(){
  var reason=document.getElementById('wantedReasonInput').value.trim();
  if(!reason){toast('Bitte einen Grund angeben!','error');return;}
  var cits=ld('cn_citizens'),i=cits.findIndex(function(c){return String(c.id)===String(_wantedTargetId);});
  if(i<0)return;
  cits[i].wanted=true;cits[i].wantedReason=reason;cits[i].wantedDate=new Date().toISOString();cits[i].wantedBy=CUR.username;
  sv('cn_citizens',cits);
  audit('WANTED_ADD',cits[i].name+' wanted: '+reason);
  toast(cits[i].name+' als gesucht markiert.','error');
  closeM('mWantedReason');
  renderCitizens();
  openCitizenDetail(_wantedTargetId);
  updateWantedBadge();
}
// ─────────────── StVO SYSTEM ───────────────

// ─────────────── StVO SYSTEM ───────────────

function buildStvoSection(c) {
  var pts = c.stvoPunkte || 0;
  var canSt = CUR.isMaster || ok('stvo_manage');
  var all = c.stvoHistory || [];
  var perPage = 5;
  var totalPages = Math.max(1, Math.ceil(all.length / perPage));
  if(_stvoPage >= totalPages) _stvoPage = totalPages - 1;
  var page = all.slice(_stvoPage * perPage, (_stvoPage + 1) * perPage);

  var histHtml = page.length === 0
    ? '<div style="font-size:.7rem;color:var(--muted);padding:8px 10px">Keine Einträge</div>'
    : page.map(function(h, i) {
        var realIdx = _stvoPage * perPage + i;
        var col = h.delta > 0 ? 'var(--danger)' : '#4caf50';
        var sign = h.delta > 0 ? '+' : '';
        var delBtn = CUR.isMaster
          ? '<button onclick="deleteStvoEntry(\''+c.id+'\','+realIdx+')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:.75rem;padding:0 4px;flex-shrink:0" title="Eintrag löschen">✕</button>'
          : '';
        return '<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid var(--border);font-size:.7rem">'
          + '<span style="color:var(--text2);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + ec(h.reason) + '</span>'
          + '<span style="color:var(--muted);font-size:.62rem;white-space:nowrap;flex-shrink:0">&#128100; ' + ec(h.officer||'–') + '</span>'
          + '<span style="color:' + col + ';font-weight:700;font-family:monospace;min-width:32px;text-align:right;flex-shrink:0">' + sign + h.delta + '</span>'
          + '<span style="color:var(--muted);font-size:.62rem;white-space:nowrap;flex-shrink:0">' + new Date(h.ts).toLocaleDateString('de-DE') + '</span>'
          + delBtn
          + '</div>';
      }).join('');

  var paginationHtml = all.length > perPage
    ? '<div style="display:flex;justify-content:space-between;align-items:center;padding:5px 10px;border-top:1px solid var(--border);font-size:.65rem;color:var(--muted)">'
        + '<button class="btn btn-ghost btn-sm" style="font-size:.6rem;padding:2px 8px" '
          + (_stvoPage > 0 ? 'onclick="stvoChangePage(' + (_stvoPage-1) + ',\'' + c.id + '\')"' : 'disabled style="opacity:.3"')
          + '>&#8592; Zurück</button>'
        + '<span>Seite ' + (_stvoPage+1) + ' / ' + totalPages + '</span>'
        + '<button class="btn btn-ghost btn-sm" style="font-size:.6rem;padding:2px 8px" '
          + (_stvoPage < totalPages-1 ? 'onclick="stvoChangePage(' + (_stvoPage+1) + ',\'' + c.id + '\')"' : 'disabled style="opacity:.3"')
          + '>Weiter &#8594;</button>'
      + '</div>'
    : '';

  var btnHtml = canSt
    ? '<div style="display:flex;gap:6px;margin-top:10px">'
        + '<button class="btn btn-ghost btn-sm" style="flex:1;justify-content:center" onclick="openStvoModal(\'' + c.id + '\',\'minus\')">− Punkte</button>'
        + '<button class="btn btn-danger btn-sm" style="flex:1;justify-content:center" onclick="openStvoModal(\'' + c.id + '\',\'plus\')">+ Punkte</button>'
      + '</div>'
    : '';

  return '<hr class="detail-divider"/>'
    + '<div style="margin-bottom:14px">'
      + '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">'
        + '<div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em">StVO Punkte</div>'
        + '<div style="font-family:monospace;font-size:1.35rem;font-weight:700;color:var(--accent)">' + pts + ' <span style="font-size:.7rem;font-weight:400">Pkt.</span></div>'
      + '</div>'
      + '<div style="background:var(--panel2);border:1px solid var(--border);border-radius:4px;overflow:hidden">'
        + '<div style="padding:5px 10px;background:var(--bg);border-bottom:1px solid var(--border);font-size:.6rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em">Letzte Einträge</div>'
        + histHtml
        + paginationHtml
      + '</div>'
      + btnHtml
    + '</div>';
}

function stvoChangePage(page, citId) {
  _stvoPage = page;
  openCitizenDetail(citId);
  setTimeout(function(){ cdSwitchTab('akt'); }, 10);
}

function deleteStvoEntry(citId, idx) {
  if(!CUR.isMaster){ toast('Keine Berechtigung!','error'); return; }
  var cits = ld('cn_citizens');
  var i = cits.findIndex(function(x){ return String(x.id) === String(citId); });
  if(i < 0) return;
  var entry = (cits[i].stvoHistory || [])[idx];
  if(!entry) return;
  // Punkte zurückrechnen
  cits[i].stvoPunkte = Math.max(0, (cits[i].stvoPunkte || 0) - entry.delta);
  cits[i].stvoHistory.splice(idx, 1);
  sv('cn_citizens', cits);
  audit('STVO_DELETE', cits[i].name + ': Eintrag gelöscht – ' + entry.reason + ' (' + (entry.delta > 0 ? '+' : '') + entry.delta + ' Pkt.)');
  toast('Eintrag gelöscht. Punkte angepasst.', 'success');
  // Seite ggf. zurücksetzen
  var newTotal = Math.max(1, Math.ceil(cits[i].stvoHistory.length / 5));
  if(_stvoPage >= newTotal) _stvoPage = newTotal - 1;
  openCitizenDetail(citId);
  setTimeout(function(){ cdSwitchTab('akt'); }, 10);
}

var _stvoTargetId = null;
var _stvoMode = 'plus';

function openStvoModal(citId, mode) {
  if (!CUR.isMaster && !ok('stvo_manage')) { toast('Keine Berechtigung!', 'error'); return; }
  _stvoTargetId = citId;
  _stvoMode = mode;
  var c = ld('cn_citizens').find(function(x) { return x.id === citId; });
  var pts = c ? (c.stvoPunkte || 0) : 0;
  document.getElementById('stvoModalTitle').textContent = mode === 'plus' ? 'StVO Punkte hinzufügen' : 'StVO Punkte abziehen';
  document.getElementById('stvoModalTitle').style.color = mode === 'plus' ? 'var(--danger)' : '#4caf50';
  document.getElementById('stvoCurrentPts').textContent = pts + ' Punkte';
  document.getElementById('stvoAmount').value = '';
  document.getElementById('stvoReason').value = '';
  document.getElementById('stvoPreview').textContent = '';
  var sb = document.getElementById('stvoSaveBtn');
  sb.style.cssText = '';
  sb.className = mode === 'plus' ? 'btn btn-danger' : 'btn btn-primary';
  openM('mStvo');
  setTimeout(function() { document.getElementById('stvoAmount').focus(); }, 100);
}

function stvoUpdatePreview() {
  var c = ld('cn_citizens').find(function(x) { return x.id === _stvoTargetId; });
  var cur = c ? (c.stvoPunkte || 0) : 0;
  var amt = parseInt(document.getElementById('stvoAmount').value) || 0;
  var prev = document.getElementById('stvoPreview');
  if (amt <= 0) { prev.textContent = ''; return; }
  var newPts = _stvoMode === 'plus' ? cur + amt : Math.max(0, cur - amt);
  prev.textContent = cur + ' → ' + newPts + ' Pkt.';
  prev.style.color = _stvoMode === 'plus' ? 'var(--danger)' : '#4caf50';
}

function saveStvo() {
  if (!CUR.isMaster && !ok('stvo_manage')) { toast('Keine Berechtigung!', 'error'); return; }
  var amt = parseInt(document.getElementById('stvoAmount').value) || 0;
  var reason = document.getElementById('stvoReason').value.trim();
  if (amt <= 0) { toast('Bitte eine gültige Punktzahl eingeben!', 'error'); return; }
  if (!reason) { toast('Bitte einen Grund angeben!', 'error'); return; }
  var cits = ld('cn_citizens');
  var i = cits.findIndex(function(x) { return x.id === _stvoTargetId; });
  if (i < 0) return;
  var delta = _stvoMode === 'plus' ? amt : -amt;
  var before = cits[i].stvoPunkte || 0;
  cits[i].stvoPunkte = Math.max(0, before + delta);
  if (!cits[i].stvoHistory) cits[i].stvoHistory = [];
  cits[i].stvoHistory.unshift({ delta: delta, reason: reason, officer: CUR.username, before: before, after: cits[i].stvoPunkte, ts: new Date().toISOString() });
  if (cits[i].stvoHistory.length > 50) cits[i].stvoHistory = cits[i].stvoHistory.slice(0, 50);
  sv('cn_citizens', cits);
  audit('STVO_' + (delta > 0 ? 'ADD' : 'SUB'), cits[i].name + ': ' + (delta > 0 ? '+' : '') + delta + ' Pkt. (' + reason + ') → ' + cits[i].stvoPunkte + ' Pkt.');
  closeM('mStvo');
  toast((delta > 0 ? '+' : '') + delta + ' StVO Punkte – Neu: ' + cits[i].stvoPunkte + ' Pkt.', delta > 0 ? 'error' : 'success');
  openCitizenDetail(_stvoTargetId);
}

// ─────────────── END StVO ───────────────

function deleteAllCitizens(){
  if(!CUR.isMaster){toast('Keine Berechtigung!','error');return;}
  var count=ld('cn_citizens').length;
  if(count===0){toast('Keine Bürger vorhanden.','error');return;}
  askConfirm('Wirklich ALLE '+count+' Bürger löschen? Diese Aktion kann nicht rückgängig gemacht werden!',function(){
    sv('cn_citizens',[]);
    audit('CITIZEN_DELETE_ALL','Alle '+count+' Bürger gelöscht');
    renderCitizens();
    toast('Alle '+count+' Bürger wurden gelöscht.','error');
  });
}

function updateWantedBadge(){}

function openJobChangeFromCitizen(uid){
  closeM('mCitizenDetail');
  openJobChange(uid);
}

function openAddJobToCitizen(citId){
  var c=ld('cn_citizens').find(function(c){return String(c.id)===String(citId);});
  if(!c)return;
  DETAIL_CIT=citId;

  var jSel=document.getElementById('ajtcJob');
  var allJobs=ld('cn_jobs');

  // give_job Permission: Benutzer kann nur seinen eigenen Job vergeben
  var canGive=ok('give_job')&&!CUR.isMaster;
  if(canGive){
    // Nur den eigenen Hauptjob anzeigen
    var myJob=gJ(CUR.mainJob);
    if(!myJob){ toast('Kein Job zugewiesen – kann keinen Job vergeben!','error'); return; }
    var myRang=gR(CUR.mainJob,CUR.mainRang);
    var myLevel=myRang?myRang.level:999;
    // Nur Ränge unter eigenem Rang
    var allowedRanks=myJob.ranks.filter(function(r){return r.level<myLevel;});
    if(!allowedRanks.length){ toast('Kein Rang unter deinem verfügbar!','error'); return; }
    jSel.innerHTML='<option value="'+myJob.id+'">'+ec(myJob.name)+'</option>';
    jSel.value=myJob.id;
    jSel.disabled=true;
    // Rang-Select befüllen mit erlaubten Rängen
    var grp=document.getElementById('ajtcRangGrp'),rSel=document.getElementById('ajtcRang');
    rSel.innerHTML=allowedRanks.map(function(r){return'<option value="'+r.id+'">'+ec(r.name)+' (Lv.'+r.level+')</option>';}).join('');
    grp.classList.remove('hidden');
  } else if(CUR.isMaster){
    // Admin: alle Jobs sichtbar
    jSel.disabled=false;
    jSel.innerHTML='<option value="">-- Beruf auswählen --</option>'+allJobs.map(function(j){return'<option value="'+j.id+'">'+ec(j.name)+(j.isSecondJob?' (Zweitberuf)':'')+'</option>';}).join('');
    document.getElementById('ajtcRangGrp').classList.add('hidden');
  } else {
    toast('Keine Berechtigung!','error'); return;
  }

  document.getElementById('ajtcJobType').value='second';
  openM('mAddJobToBürger');
}
function updateAJTCRang(){
  if(ok('give_job')&&!CUR.isMaster) return; // bei give_job bereits vorbefüllt
  var jid=document.getElementById('ajtcJob').value,grp=document.getElementById('ajtcRangGrp'),rSel=document.getElementById('ajtcRang');
  if(!jid){grp.classList.add('hidden');return;}
  var j=gJ(jid);if(!j||!j.ranks.length){grp.classList.add('hidden');return;}
  rSel.innerHTML=j.ranks.map(function(r){return'<option value="'+r.id+'">'+ec(r.name)+' (Lv.'+r.level+')</option>';}).join('');
  grp.classList.remove('hidden');
}
function saveAddJobToCitizen(){
  var jobType=document.getElementById('ajtcJobType').value;
  var jid=document.getElementById('ajtcJob').value;
  var rid=document.getElementById('ajtcRang').value;
  if(!jid){toast('Bitte einen Beruf auswählen!','error');return;}

  // give_job Permission prüfen: Rang muss unter eigenem sein
  if(ok('give_job')&&!CUR.isMaster){
    if(jid!==CUR.mainJob){toast('Du kannst nur deinen eigenen Job vergeben!','error');return;}
    var myRang=gR(CUR.mainJob,CUR.mainRang);
    var targetRang=gR(jid,rid);
    if(myRang&&targetRang&&targetRang.level>=myRang.level){toast('Du kannst nur Ränge unter deinem eigenen vergeben!','error');return;}
  }

  var cits=ld('cn_citizens'),i=cits.findIndex(function(c){return String(c.id)===String(DETAIL_CIT);});
  if(i<0)return;
  if(jobType==='first'){
    cits[i].jobId=jid; cits[i].rankId=rid||null;
  } else if(jobType==='second'){
    if(cits[i].secondJobId){toast('Bürger hat bereits einen zweiten Beruf!','error');return;}
    cits[i].secondJobId=jid;cits[i].secondRangId=rid||null;
  }else if(jobType==='third'){
    if(cits[i].thirdJobId){toast('Bürger hat bereits einen dritten Beruf!','error');return;}
    cits[i].thirdJobId=jid;cits[i].thirdRangId=rid||null;
  }
  cits[i].updatedAt=new Date().toISOString();
  sv('cn_citizens',cits);

  // Verknüpften Account synchronisieren — per linkedUserId ODER per identifier suchen
  var lu=null;
  if(cits[i].linkedUserId) lu=gU(cits[i].linkedUserId);
  if(!lu && cits[i].identifier){
    var allUsers=ld('cn_users');
    lu=allUsers.find(function(u){
      if(!u.identifier)return false;
      return u.identifier===cits[i].identifier
        ||u.identifier===cits[i].identifier.replace('license:','')
        ||'license:'+u.identifier===cits[i].identifier;
    })||null;
  }
  if(lu){
    // Citizen mit User verknüpfen falls noch nicht
    if(!cits[i].linkedUserId){cits[i].linkedUserId=lu.id;sv('cn_citizens',cits);}
    // Alle Jobs direkt übertragen
    var uArr=ld('cn_users'),ui=uArr.findIndex(function(u){return u.id===lu.id;});
    if(ui>=0){
      uArr[ui].mainJob   = cits[i].jobId      || cits[i].job       || null;
      uArr[ui].mainRang  = cits[i].rankId     || cits[i].job_rank  || null;
      uArr[ui].secondJob = cits[i].secondJobId|| cits[i].second_job|| null;
      uArr[ui].secondRang= cits[i].secondRangId||cits[i].second_rank||null;
      uArr[ui].thirdJob  = cits[i].thirdJobId || cits[i].third_job || null;
      uArr[ui].thirdRang = cits[i].thirdRangId|| cits[i].third_rank|| null;
      sv('cn_users',uArr);
      if(lu.id===CUR.id){CUR=gU(CUR.id);renderAusweis();document.getElementById('topJobBadge').textContent=jN(CUR.mainJob)||'--';document.getElementById('topRangBadge').textContent=rN(CUR.mainJob,CUR.mainRang)||'--';}
    }
  }

  var jsel=document.getElementById('ajtcJob');
  if(jsel) jsel.disabled=false;
  var typeLabel=jobType==='first'?'Hauptberuf':jobType==='second'?'Zweitberuf':'Dritter Beruf';
  audit('CITIZEN_JOB_ADD',cits[i].name+' -> '+typeLabel+': '+jN(jid)+(rid?' | Rang: '+rN(jid,rid):''));
  closeM('mAddJobToBürger');
  openCitizenDetail(DETAIL_CIT);
  toast(typeLabel+' gesetzt: '+jN(jid)+(rid?' | '+rN(jid,rid):''),'success');
}
function removeJobFromCitizen(citId,jobType){
  var cits=ld('cn_citizens'),i=cits.findIndex(function(c){return String(c.id)===String(citId);});
  if(i<0)return;
  var jobName='';
  if(jobType==='second'){
    jobName=jN(cits[i].secondJobId)||'Zweitberuf';
    cits[i].secondJobId=null;cits[i].secondRangId=null;
  }else if(jobType==='third'){
    jobName=jN(cits[i].thirdJobId)||'Dritter Beruf';
    cits[i].thirdJobId=null;cits[i].thirdRangId=null;
  }
  cits[i].updatedAt=new Date().toISOString();
  sv('cn_citizens',cits);
  // Verknüpften User synchronisieren
  var luR=null;
  if(cits[i].linkedUserId) luR=gU(cits[i].linkedUserId);
  if(!luR&&cits[i].identifier){
    var allU=ld('cn_users');
    luR=allU.find(function(u){if(!u.identifier)return false;return u.identifier===cits[i].identifier||'license:'+u.identifier===cits[i].identifier||u.identifier===cits[i].identifier.replace('license:','');})||null;
  }
  if(luR){
    var uA=ld('cn_users'),uI=uA.findIndex(function(u){return u.id===luR.id;});
    if(uI>=0){
      uA[uI].mainJob=cits[i].jobId||cits[i].job||null;uA[uI].mainRang=cits[i].rankId||cits[i].job_rank||null;
      uA[uI].secondJob=cits[i].secondJobId||cits[i].second_job||null;uA[uI].secondRang=cits[i].secondRangId||cits[i].second_rank||null;
      uA[uI].thirdJob=cits[i].thirdJobId||cits[i].third_job||null;uA[uI].thirdRang=cits[i].thirdRangId||cits[i].third_rank||null;
      sv('cn_users',uA);
    }
  }
  audit('CITIZEN_JOB_REMOVE',cits[i].name+' -> '+jobName+' removed');
  openCitizenDetail(citId);
  toast(jobName+' entfernt.','success');
}
function fireMainJobFromCitizen(citId){
  var cits=ld('cn_citizens'),i=cits.findIndex(function(c){return String(c.id)===String(citId);});
  if(i<0)return;
  var c=cits[i];
  // give_job Berechtigung: nur eigenen Job kündigen, nur niedrigere Ränge
  if(!CUR.isMaster){
    if(!ok('give_job')){toast('Keine Berechtigung!','error');return;}
    if(c.jobId!==CUR.mainJob){toast('Du kannst nur Mitglieder deines eigenen Jobs kündigen!','error');return;}
    var myRang=gR(CUR.mainJob,CUR.mainRang);
    var targetRang=gR(c.jobId,c.rankId);
    if(myRang&&targetRang&&targetRang.level>=myRang.level){toast('Du kannst nur Personen mit niedrigerem Rang als deinem kündigen!','error');return;}
  }
  var oldJobName=jN(c.jobId)||c.jobId||'Unbekannt';
  askConfirm(ec(c.name||c.firstname)+' aus "'+ec(oldJobName)+'" entlassen? Der Beruf wird auf Unemployed gesetzt.',function(){
    cits[i].jobId=null;cits[i].rankId=null;
    cits[i].updatedAt=new Date().toISOString();
    sv('cn_citizens',cits);
    // Verknüpften User synchronisieren
    var luR=null;
    if(c.linkedUserId)luR=gU(c.linkedUserId);
    if(!luR&&c.identifier){
      var allU=ld('cn_users');
      luR=allU.find(function(u){if(!u.identifier)return false;return u.identifier===c.identifier||'license:'+u.identifier===c.identifier||u.identifier===c.identifier.replace('license:','');})||null;
    }
    if(luR){
      var uA=ld('cn_users'),uI=uA.findIndex(function(u){return u.id===luR.id;});
      if(uI>=0){uA[uI].mainJob=null;uA[uI].mainRang=null;sv('cn_users',uA);}
    }
    audit('CITIZEN_FIRED',c.name+' -> entlassen aus '+oldJobName);
    openCitizenDetail(citId);
    toast(ec(c.name||c.firstname)+' wurde aus "'+ec(oldJobName)+'" entlassen.','success');
  });
}
function toggleImmigrationVerification(citId){
  var cits=ld('cn_citizens'),i=cits.findIndex(function(c){return String(c.id)===String(citId);});
  if(i<0)return;
  var checked=document.getElementById('citImmigrationCheck').checked;
  cits[i].immigrationVerification=checked;
  cits[i].updatedAt=new Date().toISOString();
  sv('cn_citizens',cits);
  audit('IMMIGRATION_VERIFICATION',cits[i].name+' -> '+(checked?'Granted':'Revoked'));
  toast('Einreise-Verifizierung '+(checked?'erteilt':'entzogen')+'.','success');
}


function renderDocs(){
  var list=document.getElementById('docList'),q=(document.getElementById('docSearch').value||'').toLowerCase();
  var arr=ld('cn_documents');
  var userLevel=getDocAccessLevel();
  

  if(q)arr=arr.filter(function(d){return d.title.toLowerCase().indexOf(q)>=0||d.type.toLowerCase().indexOf(q)>=0;});
  

  arr=arr.filter(function(d){

    if(CUR.isMaster)return true;

    if(d.creatorId===CUR.id)return true;

    if(d.accessList&&d.accessList.indexOf(CUR.id)>=0)return true;

    if(ok('doc_read')&&userLevel>0){
      var docLevel=d.level||2;
      if(userLevel<docLevel)return false;
      // Rang-Sichtbarkeits-Sperre prüfen
      return docCanBeSeenBy(d,CUR);
    }
    return false;
  });
  
  document.getElementById('docCount').textContent=arr.length+' Dokumente';
  if(!arr.length){list.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1F4C4;</div><div>Keine Dokumente</div></div>';return;}
  list.innerHTML=arr.map(function(d){
    var levelBadge='<span class="badge badge-muted" style="font-size:.55rem">L'+((d.level||2))+'</span>';
    return'<div class="card" onclick="openDocDetail(\''+d.id+'\')">'+
    '<div class="card-left"><div class="card-id">DOK-'+String(d.nr||d.id||0).padStart(4,'0')+'</div><div class="card-label">'+ec(d.type)+'</div><div class="card-title">'+ec(d.title)+'</div></div>'+
    '<div class="card-right">'+levelBadge+'<span class="card-meta">'+(d.citizenId?ec(cN(d.citizenId)):'')+'</span><span class="card-meta">'+ec(d.date)+'</span><span class="card-arrow">&#x203A;</span></div></div>';
  }).join('');
}
function getDocTypes(){
  var stored=localStorage.getItem('cn_doc_types');
  if(stored)return JSON.parse(stored);
  return [
    {name:'Strafakte',headerText:'STRAFAKTE - COAST.NET\nAusgestellt am: {DATUM} | Beamter: {BEAMTER}\n' + '='.repeat(50),template:'Bürger: {CITIZEN}\n\n--- ANSCHULDIGUNGEN ---\n\n\n--- BEWEISE ---\n\n\n--- MAßNAHMEN ---\n\n'},
    {name:'Strafanzeige',headerText:'STRAFANZEIGE - COAST.NET\nAufgenommen am: {DATUM} | Beamter: {BEAMTER}\n' + '='.repeat(50),template:'Anzeige gegen: {BÜRGER}\n\n--- SACHVERHALT ---\n\n\n--- ZEUGEN ---\n\n'},
    {name:'Bußgeldbescheid',headerText:'BUßGELDBESCHEID - COAST.NET\nAusgestellt am: {DATUM} | Beamter: {BEAMTER}\n' + '='.repeat(50),template:'An: {BÜRGER}\n\n--- VERSTOESS ---\n\n\n--- STRAFE ---\n\n'},
    {name:'Haftbefehl',headerText:'HAFTBEFEHL - COAST.NET\nAusgestellt am: {DATUM} | Beamter: {BEAMTER}\n' + '='.repeat(50),template:'Person: {BÜRGER}\n\n--- HAFTGRUND ---\n\n\n--- GERICHTLICHE ANORDNUNG ---\n\n'},
    {name:'Entscheidung',headerText:'ENTSCHEIDUNG - COAST.NET\nAusgestellt am: {DATUM} | Behörde: {BEAMTER}\n' + '='.repeat(50),template:'Betreff: {BÜRGER}\n\n--- ENTSCHEIDUNGSINHALT ---\n\n'}
  ];
}
function fillTypeSel(){
  var sel=document.getElementById('dType');
  var allTypes=getDocTypes();
  var allowed=allTypes;
  if(!CUR.isMaster){
    var r=gR(CUR.mainJob,CUR.mainRang);
    var permitted=r&&r.allowedDocTypes;
    if(permitted&&permitted.length>0){
      allowed=allTypes.filter(function(t){return permitted.indexOf(t.name)>=0;});
    }
  }
  if(!allowed.length)allowed=allTypes;
  sel.innerHTML=allowed.map(function(t){return'<option value="'+ec(t.name)+'">'+ec(t.name)+'</option>';}).join('');
}
function fillPlaceholders(text,cName){
  return text
    .replace(/{CITIZEN}/g,cName||'___________')
    .replace(/{BUERGER}/g,cName||'___________')
    .replace(/{DATE}/g,td())
    .replace(/{DATUM}/g,td())
    .replace(/{OFFICER}/g,CUR.username)
    .replace(/{BEAMTER}/g,CUR.username)
    .replace(/{NAME}/g,cName||'___________');
}
function updateDocHeader(){
  var sel=document.getElementById('dType');
  var types=getDocTypes();
  var t=types.find(function(x){return x.name===sel.value;});
  var hEl=document.getElementById('dHeader');
  if(!t||!t.headerText){if(hEl)hEl.style.display='none';return;}
  var cSel=document.getElementById('dBürger');
  var cName=cSel.value?cN(cSel.value):'___________';
  if(hEl){hEl.value=fillPlaceholders(t.headerText,cName);hEl.style.display='block';hEl.rows=t.headerText.split('\n').length+1;}
}
function loadDocTemplate(){
  var sel=document.getElementById('dType');
  var editId=document.getElementById('dEditId').value;
  if(editId){updateDocHeader();return;}
  var types=getDocTypes();
  var t=types.find(function(x){return x.name===sel.value;});
  var cSel=document.getElementById('dBürger');
  var cName=cSel.value?cN(cSel.value):'___________';
  updateDocHeader();
  if(!t||!t.template)return;
  document.getElementById('dContent').value=fillPlaceholders(t.template,cName);
}
function openDocAccessModal(){
  var blocked={};
  try{blocked=JSON.parse(document.getElementById('dBlockedRanks').value||'{}');}catch(e){}
  var allJobs=ld('cn_jobs').filter(function(j){return!j.isSecondJob;});
  var html=allJobs.map(function(job){
    var rows=job.ranks.map(function(rank){
      var key=job.id+'::'+rank.id;
      var isBlocked=blocked[key]===true;
      var ck=isBlocked?'':' checked';
      return'<label style="display:flex;align-items:center;gap:6px;font-size:.73rem;padding:6px 10px;background:var(--panel);border:1px solid var(--border);border-radius:3px;cursor:pointer;min-width:160px">'+
        '<input type="checkbox" id="da_'+job.id+'__'+rank.id+'"'+ck+'/>'+
        '<span>'+(isBlocked?'❌':'✅')+' </span>'+
        '<span>'+ec(rank.name)+'</span>'+
        '<span style="color:var(--muted);font-size:.6rem;margin-left:2px">(Lv.'+rank.level+')</span></label>';
    }).join('');
    return'<div style="margin-bottom:16px">'+
      '<div style="font-size:.68rem;color:var(--accent);font-weight:600;margin-bottom:7px;text-transform:uppercase;letter-spacing:.08em">'+ec(job.name)+'</div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:6px">'+rows+'</div></div>';
  }).join('');
  document.getElementById('mDABody').innerHTML=
    '<div style="font-size:.72rem;color:var(--text2);margin-bottom:16px;padding:10px;background:var(--panel2);border:1px solid var(--border);border-radius:3px">'+
    'Angehakt ✅ = Rang <strong>kann</strong> das Dokument sehen. Nicht angehakt ❌ = Rang ist gesperrt.</div>'+
    '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px">'+
    html+'</div>';
  // Icon live updaten wenn Checkbox klick
  document.getElementById('mDABody').querySelectorAll('input[type=checkbox]').forEach(function(cb){
    cb.addEventListener('change',function(){
      var icon=this.parentElement.querySelector('span:nth-child(2)');
      if(icon)icon.textContent=this.checked?'✅ ':'❌ ';
    });
  });
  openM('mDocAccess');
}

function saveDocAccessRules(){
  var blocked={};
  var allJobs=ld('cn_jobs').filter(function(j){return!j.isSecondJob;});
  allJobs.forEach(function(job){
    job.ranks.forEach(function(rank){
      var el=document.getElementById('da_'+job.id+'__'+rank.id);
      if(el&&!el.checked)blocked[job.id+'::'+rank.id]=true;
    });
  });
  document.getElementById('dBlockedRanks').value=JSON.stringify(blocked);
  var count=Object.keys(blocked).length;
  var btn=document.getElementById('dAccessRulesBtn');
  if(btn)btn.textContent='⚙ Rang-Sichtbarkeit'+(count>0?' ('+count+' gesperrt)':'');
  closeM('mDocAccess');
  toast('Rang-Sichtbarkeit übernommen.','success');
}

function docCanBeSeenBy(d,user){
  if(!d.blockedRanks)return true;
  // Prüfe ob einer der Jobs/Ränge des Users gesperrt ist
  var jobs=[
    {job:user.mainJob,rang:user.mainRang},
    {job:user.secondJob,rang:user.secondRang}
  ];
  for(var ji=0;ji<jobs.length;ji++){
    var jj=jobs[ji];
    if(!jj.job)continue;
    var key=jj.job+'::'+jj.rang;
    if(d.blockedRanks[key]===true)return false;
  }
  return true;
}


function openDocModal(editId){
  if(!CUR.isMaster&&!ok('doc_create')){toast('Keine Berechtigung!','error');return;}
  var sel=document.getElementById('dBürger');
  sel.innerHTML='<option value="">-- keine --</option>'+ld('cn_citizens').map(function(c){return'<option value="'+c.id+'">'+ec(c.name)+' (CIT-'+String(c.nr||c.id||0).padStart(4,'0')+')</option>';}).join('');
  fillTypeSel();
  document.getElementById('dType').onchange=function(){loadDocTemplate();};
  document.getElementById('dBürger').onchange=function(){loadDocTemplate();};
  document.getElementById('dEditId').value=editId||'';
  document.getElementById('mDocTitle').textContent=editId?'Edit Document':'Dokument erstellen';
  if(editId){
    var d=ld('cn_documents').find(function(d){return d.id===editId;});
    document.getElementById('dType').value=d.type||getDocTypes()[0].name;
    document.getElementById('dTitle').value=d.title||'';
    document.getElementById('dBürger').value=d.citizenId||'';
    document.getElementById('dContent').value=d.content||'';
    document.getElementById('dNote').value=d.note||'';
    document.getElementById('dLevel').value=d.level||2;
    TEMP_ACCESS_LIST=(d.accessList||[]).slice();
    var blocked=d.blockedRanks||{};
    document.getElementById('dBlockedRanks').value=JSON.stringify(blocked);
    var bCount=Object.keys(blocked).length;
    var btn=document.getElementById('dAccessRulesBtn');
    if(btn)btn.textContent='⚙ Rang-Sichtbarkeit'+(bCount>0?' ('+bCount+' gesperrt)':'');
    // Sonder-Bearbeitung laden
    document.getElementById('dEditAccessLevel').value=d.editAccessLevel||0;
    document.getElementById('dEditAccessList').value=JSON.stringify(d.editAccessList||[]);
    var eaBtn=document.getElementById('dEditAccessBtn');
    var eaCount=(d.editAccessList||[]).length;
    if(eaBtn)eaBtn.textContent='✏️ Sonder-Bearbeitung'+((d.editAccessLevel||0)>0||eaCount>0?' (aktiv)':'');
  }else{
    ['dTitle','dContent','dNote'].forEach(function(f){document.getElementById(f).value='';});
    document.getElementById('dBürger').value='';
    document.getElementById('dLevel').value='2';
    document.getElementById('dBlockedRanks').value='{}';
    document.getElementById('dEditAccessLevel').value='0';
    document.getElementById('dEditAccessList').value='[]';
    var btn2=document.getElementById('dAccessRulesBtn');
    if(btn2)btn2.textContent='⚙ Rang-Sichtbarkeit einstellen';
    var eaBtn2=document.getElementById('dEditAccessBtn');
    if(eaBtn2)eaBtn2.textContent='✏️ Sonder-Bearbeitung einstellen';
    TEMP_ACCESS_LIST=[];
    setTimeout(loadDocTemplate,50);
  }
  renderAccessList();
  openM('mDoc');
}
function renderAccessList(){
  var el=document.getElementById('dAccessList');
  if(TEMP_ACCESS_LIST.length===0){
    el.innerHTML='<div style="color:var(--muted);font-size:.7rem">No additional persons</div>';
    return;
  }
  el.innerHTML=TEMP_ACCESS_LIST.map(function(uid){
    var u=gU(uid);
    return'<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid var(--border)">'+
      '<span>'+(u?ec(u.username)+' ('+ec(u.civId)+')':'Unbekannt')+'</span>'+
      '<button class="btn btn-danger btn-sm" style="padding:2px 8px;font-size:.6rem" onclick="removeAccess(\''+uid+'\')">X</button></div>';
  }).join('');
}
function openAddAccess(){
  var sel=document.getElementById('addAccessUser');
  sel.innerHTML='<option value="">-- Person auswählen --</option>'+
    ld('cn_users').filter(function(u){return!u.isMaster&&TEMP_ACCESS_LIST.indexOf(u.id)<0;}).map(function(u){
      return'<option value="'+u.id+'">'+ec(u.username)+' ('+ec(u.civId)+')</option>';
    }).join('');
  openM('mAddAccess');
}
function saveAddAccess(){
  var uid=document.getElementById('addAccessUser').value;
  if(!uid){toast('Bitte eine Person auswählen!','error');return;}
  if(TEMP_ACCESS_LIST.indexOf(uid)>=0){toast('Person bereits in der Liste!','error');return;}
  TEMP_ACCESS_LIST.push(uid);
  renderAccessList();
  closeM('mAddAccess');
}
function removeAccess(uid){
  TEMP_ACCESS_LIST=TEMP_ACCESS_LIST.filter(function(id){return id!==uid;});
  renderAccessList();
}
function saveDoc(){
  var title=document.getElementById('dTitle').value.trim();if(!title){toast('Titel ist erforderlich!','error');return;}
  var type=document.getElementById('dType').value,citId=document.getElementById('dBürger').value,
      content=document.getElementById('dContent').value,note=document.getElementById('dNote').value.trim(),
      level=parseInt(document.getElementById('dLevel').value)||2,
      editId=document.getElementById('dEditId').value;
  var arr=ld('cn_documents');
  var headerVal=document.getElementById('dHeader')?document.getElementById('dHeader').value:'';
  var blockedRanks={};
  try{blockedRanks=JSON.parse(document.getElementById('dBlockedRanks').value||'{}');}catch(e){}
  var editAccessLevel=parseInt(document.getElementById('dEditAccessLevel').value)||0;
  var editAccessList=[];
  try{editAccessList=JSON.parse(document.getElementById('dEditAccessList').value||'[]');}catch(e){}
  if(editId){
    var i=arr.findIndex(function(d){return d.id===editId;});
    if(i>=0){
      arr[i].title=title;arr[i].type=type;arr[i].citizenId=citId;arr[i].content=content;
      arr[i].headerText=headerVal;
      arr[i].note=note;arr[i].level=level;arr[i].accessList=TEMP_ACCESS_LIST.slice();
      arr[i].blockedRanks=blockedRanks;
      arr[i].editAccessLevel=editAccessLevel;
      arr[i].editAccessList=editAccessList;
      arr[i].updatedAt=new Date().toISOString();
    }
    audit('DOC_EDIT','Dok bearb: '+title);
  }else{
    var nr=nId();
    arr.unshift({
      id:'doc_'+nr,nr:nr,title:title,type:type,citizenId:citId,content:content,
      headerText:headerVal,note:note,
      level:level,accessList:TEMP_ACCESS_LIST.slice(),
      blockedRanks:blockedRanks,
      editAccessLevel:editAccessLevel,
      editAccessList:editAccessList,
      creatorId:CUR.id,creatorName:CUR.username,
      creatorJob:jN(CUR.mainJob)||'--',creatorRang:rN(CUR.mainJob,CUR.mainRang)||'--',
      date:td(),createdAt:new Date().toISOString()
    });
    audit('DOC_CREATE','New document: '+title+' ('+type+') Level '+level);
  }
  sv('cn_documents',arr);renderDocs();closeM('mDoc');
  toast(editId?'Dokument aktualisiert.':'Dokument gespeichert.','success');
}
function _checkDocRankRule(field){
// NEU: Sonder-Bearbeitung Modal öffnen
function openDocEditAccessModal(){
  var allUsers=ld('cn_users');
  var curLevel=parseInt(document.getElementById('dEditAccessLevel').value)||0;
  var curList=[];
  try{curList=JSON.parse(document.getElementById('dEditAccessList').value||'[]');}catch(e){}
  document.getElementById('deaLevel').value=String(curLevel);
  var sel=document.getElementById('deaPersonSelect');
  sel.innerHTML='<option value="">-- Person auswählen --</option>'+allUsers.filter(function(u){return!u.isMaster;}).map(function(u){return'<option value="'+u.id+'">'+ec(u.username)+(u.civId?' ('+ec(u.civId)+')':'')+'</option>';}).join('');
  renderDeaPersonList(curList);
  openM('mDocEditAccess');
}
function renderDeaPersonList(list){
  var el=document.getElementById('deaPersonList');
  if(!list||!list.length){el.innerHTML='<div style="color:var(--muted);font-size:.7rem">Keine zusätzlichen Personen</div>';return;}
  el.innerHTML=list.map(function(uid){var u=gU(uid);return'<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 0;border-bottom:1px solid var(--border)"><span>'+(u?ec(u.username)+' ('+ec(u.civId||'--')+')':'Unbekannt')+'</span><button class="btn btn-danger btn-sm" style="padding:2px 8px;font-size:.6rem" onclick="removeDeaPerson(\''+uid+'\')">X</button></div>';}).join('');
}
function addDeaPerson(){
  var uid=document.getElementById('deaPersonSelect').value;
  if(!uid){toast('Bitte eine Person auswählen!','error');return;}
  var curList=[];
  try{curList=JSON.parse(document.getElementById('dEditAccessList').value||'[]');}catch(e){}
  if(curList.indexOf(uid)>=0){toast('Person bereits eingetragen!','error');return;}
  curList.push(uid);
  document.getElementById('dEditAccessList').value=JSON.stringify(curList);
  renderDeaPersonList(curList);
}
function removeDeaPerson(uid){
  var curList=[];
  try{curList=JSON.parse(document.getElementById('dEditAccessList').value||'[]');}catch(e){}
  curList=curList.filter(function(id){return id!==uid;});
  document.getElementById('dEditAccessList').value=JSON.stringify(curList);
  renderDeaPersonList(curList);
}
function saveDocEditAccess(){
  var lvl=parseInt(document.getElementById('deaLevel').value)||0;
  var curList=[];
  try{curList=JSON.parse(document.getElementById('dEditAccessList').value||'[]');}catch(e){}
  document.getElementById('dEditAccessLevel').value=String(lvl);
  var eaBtn=document.getElementById('dEditAccessBtn');
  if(eaBtn)eaBtn.textContent='✏️ Sonder-Bearbeitung'+(lvl>0||curList.length>0?' (aktiv)':' einstellen');
  closeM('mDocEditAccess');
  toast('Sonder-Bearbeitung übernommen.','success');
}
// Prüft ob CUR das Dokument bearbeiten darf (inkl. Sonder-Bearbeitung)
function canEditDoc(d){
  if(CUR.isMaster)return true;
  // Sonder-Bearbeitung: direkte Person
  if(d.editAccessList&&d.editAccessList.indexOf(CUR.id)>=0)return true;
  // Sonder-Bearbeitung: Mindest-Level
  if(d.editAccessLevel&&d.editAccessLevel>0){
    var myJobs=[{job:CUR.mainJob,rang:CUR.mainRang},{job:CUR.secondJob,rang:CUR.secondRang}];
    var passes=myJobs.some(function(mj){if(!mj.job)return false;var r=gR(mj.job,mj.rang);return r&&(r.docAccessLevel||0)>=d.editAccessLevel;});
    if(passes)return true;
  }
  // Typ-Editlevel prüfen
  var types=getDocTypes();
  var t=types.find(function(x){return x.name===d.type;});
  if(t&&t.editLevel&&t.editLevel>0){
    var myJobs2=[{job:CUR.mainJob,rang:CUR.mainRang},{job:CUR.secondJob,rang:CUR.secondRang}];
    var passesType=myJobs2.some(function(mj){if(!mj.job)return false;var r=gR(mj.job,mj.rang);return r&&(r.docAccessLevel||0)>=t.editLevel;});
    if(!passesType)return false;
  }
  // Ersteller darf eigene Dokumente bearbeiten
  if(d.creatorId===CUR.id&&ok('doc_create'))return true;
  // Rang-Regel
  return _checkDocRankRule('docEditRules');
}
// Ende Sonder-Bearbeitung
function _checkDocRankRule(field){
  // Prüft ob CUR's Rang/Job die Regel für das Feld (docEditRules/docDeleteRules) erfüllt
  var myJobs=[
    {job:CUR.mainJob,rang:CUR.mainRang},
    {job:CUR.secondJob,rang:CUR.secondRang},
    {job:CUR.thirdJob,rang:CUR.thirdRang}
  ];
  return myJobs.some(function(mj){
    if(!mj.job)return false;
    var r=gR(mj.job,mj.rang);
    var rules=r&&r[field];
    if(!rules||!rules.length)return false;
    return rules.some(function(rule){
      if(!rule.jobId)return true;
      if(rule.jobId!==mj.job)return false;
      var myLv=r?(r.level||0):0;
      return myLv>=(rule.minLevel||0);
    });
  });
}
function openDocDetail(id){
  DETAIL_DOC=id;var d=ld('cn_documents').find(function(d){return d.id===id;});if(!d)return;
  var levelNames=['','Public','Officers','Middle Rangs','High Rangs','Highest Rangs'];
  var levelBadge='<span class="badge badge-accent">Level '+(d.level||2)+' - '+(levelNames[d.level||2]||'')+'</span>';
  var accessListHTML='';
  if(d.accessList&&d.accessList.length>0){
    accessListHTML='<hr class="detail-divider"/><div class="detail-label" style="margin-bottom:6px">Additional Access ('+d.accessList.length+')</div>'+
      '<div style="display:flex;flex-wrap:wrap;gap:6px">'+
      d.accessList.map(function(uid){
        var u=gU(uid);
        return u?'<span class="badge badge-accent">'+ec(u.username)+'</span>':'';
      }).join('')+'</div>';
  }
  document.getElementById('mDDTitle').innerHTML='<span style="color:var(--danger)">'+ec(d.type)+'</span> '+ec(d.title);
  document.getElementById('mDDBody').innerHTML=
    '<div class="detail-grid">'+
    '<div class="detail-field"><div class="detail-label">Type</div><div class="detail-value">'+ec(d.type)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Date</div><div class="detail-value">'+ec(d.date)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Creator</div><div class="detail-value">'+ec(d.creatorName)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Job / Rang</div><div class="detail-value">'+ec(d.creatorJob)+' / '+ec(d.creatorRang)+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Bürger</div><div class="detail-value">'+(d.citizenId?ec(cN(d.citizenId)):'--')+'</div></div>'+
    '<div class="detail-field"><div class="detail-label">Visibility Level</div><div class="detail-value">'+levelBadge+'</div></div>'+
    '</div>'+accessListHTML+
    (d.headerText?'<hr class="detail-divider"/><div class="detail-label" style="margin-bottom:6px;color:var(--danger)">Required Text</div><div style="font-size:.78rem;line-height:1.6;color:var(--text2);white-space:pre-wrap;background:rgba(190,6,6,.06);padding:12px 14px;border:1px solid rgba(190,6,6,.25);font-family:monospace">'+ec(d.headerText)+'</div>':'')+
    (d.content?'<hr class="detail-divider"/><div class="detail-label" style="margin-bottom:8px">Content</div><div style="font-size:.88rem;line-height:1.7;color:var(--text2);white-space:pre-wrap;background:var(--panel2);padding:14px;border:1px solid var(--border)">'+ec(d.content)+'</div>':'')+
    (d.note?'<hr class="detail-divider"/><div class="detail-label" style="margin-bottom:4px">Note</div><div style="font-size:.82rem;color:var(--muted)">'+ec(d.note)+'</div>':'');
  
  var canEdit=canEditDoc(d);
  var canDelete=CUR.isMaster||_checkDocRankRule('docDeleteRules');
  sh('mDDEditBtn',canEdit);sh('mDDDelBtn',canDelete);
  document.getElementById('mDDEditBtn').onclick=function(){closeM('mDocDetail');openDocModal(id);};
  document.getElementById('mDDDelBtn').onclick=function(){
    var t=d.title;
    askConfirm('Dokument wirklich löschen "'+t+'"?',function(){
      sv('cn_documents',ld('cn_documents').filter(function(x){return x.id!==DETAIL_DOC;}));
      audit('DOC_DELETE','Document deleted: '+t);
      closeM('mDocDetail');renderDocs();toast('Dokument gelöscht.','error');
    });
  };
  openM('mDocDetail');
}

function renderCars(){
  var list=document.getElementById('carList'),q=(document.getElementById('carSearch').value||'').toLowerCase();
  var arr=ld('cn_cars');
  if(q)arr=arr.filter(function(c){return c.model.toLowerCase().indexOf(q)>=0||c.plate.toLowerCase().indexOf(q)>=0;});
  document.getElementById('carCount').textContent=arr.length+' Fahrzeuge';
  document.getElementById('btnAddCar').style.display=CUR.isMaster?'flex':'none';
  if(!arr.length){list.innerHTML='<div class="empty-state"><div class="empty-icon">&#x1F697;</div><div>Keine Fahrzeuge</div></div>';return;}
  list.innerHTML=arr.map(function(c){return'<div class="card" onclick="openCarDetail(\''+c.id+'\')">'+
    '<div class="card-left"><div class="card-id">'+ec(c.plate)+'</div><div class="card-label">Vehicle</div><div class="card-title">'+ec(c.model)+'</div></div>'+
    '<div class="card-right"><span class="card-meta">'+(c.ownerId?ec(cN(c.ownerId)):'--')+'</span><span class="card-arrow">&#x203A;</span></div></div>';}).join('');
}
function openCarModal(editId){
  if(!CUR.isMaster){toast('Keine Berechtigung!','error');return;}
  var sel=document.getElementById('carBesitzer');
  sel.innerHTML='<option value="">-- kein Besitzer --</option>'+ld('cn_citizens').map(function(c){return'<option value="'+c.id+'">'+ec(c.name)+' (CIT-'+String(c.nr||c.id||0).padStart(4,'0')+')</option>';}).join('');
  document.getElementById('carEditId').value=editId||'';
  document.getElementById('mCarTitle').textContent=editId?'Fahrzeug bearbeiten':'Fahrzeug hinzufügen';
  if(editId){var c=ld('cn_cars').find(function(c){return c.id===editId;});document.getElementById('carModel').value=c.model||'';document.getElementById('carPlate').value=c.plate||'';document.getElementById('carBesitzer').value=c.ownerId||'';}
  else{['carModel','carPlate'].forEach(function(f){document.getElementById(f).value='';});document.getElementById('carBesitzer').value='';}
  openM('mCar');
}
function saveCar(){
  var model=document.getElementById('carModel').value.trim(),plate=document.getElementById('carPlate').value.trim().toUpperCase(),
      owner=document.getElementById('carBesitzer').value,editId=document.getElementById('carEditId').value;
  if(!model||!plate){toast('Modell und Kennzeichen erforderlich!','error');return;}
  var arr=ld('cn_cars');
  if(arr.find(function(c){return c.plate===plate&&c.id!==editId;})){toast('Kennzeichen bereits vergeben!','error');return;}
  if(editId){var i=arr.findIndex(function(c){return c.id===editId;});if(i>=0){arr[i].model=model;arr[i].plate=plate;arr[i].ownerId=owner;}audit('CAR_EDIT','Vehicle edited: '+plate);}
  else{var nr=nId();arr.unshift({id:'car_'+nr,nr:nr,model:model,plate:plate,ownerId:owner,createdAt:new Date().toISOString()});audit('CAR_CREATE','Vehicle: '+plate+' ('+model+')');}
  sv('cn_cars',arr);renderCars();closeM('mCar');toast(editId?'Fahrzeug aktualisiert.':'Fahrzeug eingetragen.','success');
}
function openCarDetail(id){
  DETAIL_CAR=id;var c=ld('cn_cars').find(function(c){return c.id===id;});if(!c)return;
