<!-- app.html -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>COAST.NET</title>
<link rel="stylesheet" href="PDDoc.css"/>
</head>
<body>
<div class="app-layout" id="appLayout" style="display:none">
<div class="topbar">
  <div class="topbar-logo">COAST.NET</div>
  <div class="topbar-user">
    <span id="topCivId" class="badge badge-muted" style="font-family:monospace;letter-spacing:.1em"></span>
    <span id="topJobBadge" class="badge badge-muted"></span>
    <span id="topRangBadge" class="badge badge-accent"></span>
    <span id="topUsername" style="color:var(--text2);font-size:.72rem"></span>
    <button class="btn btn-ghost btn-sm" onclick="doLogout()">Abmelden</button>
  </div>
</div>
<div class="tab-nav">
  <button class="tab-btn active" id="tabAusweis" data-tab="ausweis" onclick="showTab('ausweis')">Mein Ausweis</button>
  <button class="tab-btn" data-tab="citizen" onclick="showTab('citizen')">Bürger</button>
  <button class="tab-btn" data-tab="documents" onclick="showTab('documents')">Dokumente</button>
  <button class="tab-btn" data-tab="cars" id="tabCars" onclick="showTab('cars')">Fahrzeuge</button>
  <button class="tab-btn" data-tab="lexikon" onclick="showTab('lexikon')">Lexikon</button>
  <button class="tab-btn hidden" data-tab="ids" id="tabIds" onclick="showTab('ids')">Ausweise</button>
  <button class="tab-btn hidden" data-tab="admin" id="tabAdmin" onclick="showTab('admin')">Admin</button>
  <button class="tab-btn hidden" data-tab="livemap" id="tabLivemap" onclick="showTab('livemap');initLivemap()">Live-Karte</button>
</div>
<div class="tab-content active" id="tab-ausweis">
  <div class="section-title" style="margin-bottom:24px">Mein Ausweis</div>
  <div id="ausweisCard"></div>
</div>
<div class="tab-content" id="tab-citizen">
  <div class="section-header">
    <div class="section-title">Bürgerverwaltung</div>
    <div class="section-actions">
      <span class="badge badge-muted" id="citizenCount">0 Bürger</span>
      <button class="btn-add-big" id="btnAddCitizen" onclick="openCitizenModal(null)">+</button>
    </div>
  </div>
  <div class="search-bar"><span class="search-icon">&#x1F50D;</span><input type="text" id="citizenSearch" placeholder="Bürger suchen..." oninput="renderCitizens()"/></div>
  <div class="card-list" id="citizenList"></div>
</div>
<div class="tab-content" id="tab-documents">
  <div class="section-header">
    <div class="section-title">Dokumente</div>
    <div class="section-actions">
      <span class="badge badge-muted" id="docCount">0 Dokumente</span>
      <button class="btn btn-ghost btn-sm hidden" id="btnDocTypes" onclick="openDocTypesManager()" style="font-size:.6rem;letter-spacing:.1em">&#9881; Typen</button>
      <button class="btn-add-big" onclick="openDocModal(null)">+</button>
    </div>
  </div>
  <div class="search-bar"><span class="search-icon">&#x1F50D;</span><input type="text" id="docSearch" placeholder="Dokumente suchen..." oninput="renderDocs()"/></div>
  <div class="card-list" id="docList"></div>
</div>
<div class="tab-content" id="tab-cars">
  <div class="section-header">
    <div class="section-title">Fahrzeugverwaltung</div>
    <div class="section-actions">
      <span class="badge badge-muted" id="carCount">0 Fahrzeuge</span>
      <button class="btn-add-big" id="btnAddCar" onclick="openCarModal(null)">+</button>
    </div>
  </div>
  <div class="search-bar"><span class="search-icon">&#x1F50D;</span><input type="text" id="carSearch" placeholder="Fahrzeuge suchen..." oninput="renderCars()"/></div>
  <div class="card-list" id="carList"></div>
</div>
<div class="tab-content" id="tab-lexikon">
  <div class="section-header">
    <div class="section-title">Lexikon</div>
    <div class="section-actions">
      <button class="btn btn-primary btn-sm hidden" id="btnAddLexikon" onclick="openLexikonModal(null)">+ Eintrag</button>
    </div>
  </div>
  <div class="search-bar"><span class="search-icon">&#x1F50D;</span><input type="text" id="lexikonSearch" placeholder="Lexikon durchsuchen..." oninput="renderLexikon()"/></div>
  <div class="lexikon-grid" id="lexikonGrid"></div>
</div>
<div class="tab-content" id="tab-ids">
  <div class="section-header">
    <div class="section-title">Ausweise</div>
    <div class="section-actions"><span class="badge badge-muted" id="idCount">0 IDs</span></div>
  </div>
  <div style="font-size:.72rem;color:var(--muted);margin-bottom:14px">Registrierte Accounts. Einreisebeamte können IDs Bürgern zuweisen.</div>
  <div class="search-bar"><span class="search-icon">&#x1F50D;</span><input type="text" id="idSearch" placeholder="ID oder Name suchen..." oninput="renderIds()"/></div>
  <div class="card-list" id="idList"></div>
</div>
<div class="tab-content" id="tab-admin">
  <div class="section-title" style="margin-bottom:20px" id="adminTitle">Master-Verwaltung</div>
  <div class="admin-grid" id="adminGrid">
    <div class="admin-card master-only" onclick="adminSection('users')"><div class="admin-card-icon">&#x1F465;</div><div class="admin-card-label">Verwaltung</div><div class="admin-card-title">Benutzer &amp; Rechte</div></div>
    <div class="admin-card" onclick="adminSection('jobs')"><div class="admin-card-icon">&#x1F4BC;</div><div class="admin-card-label">Verwaltung</div><div class="admin-card-title">Berufe &amp; Ränge</div></div>
    <div class="admin-card master-only" onclick="adminSection('passwords')"><div class="admin-card-icon">&#x1F511;</div><div class="admin-card-label">Sicherheit</div><div class="admin-card-title">Alle Passwörter</div></div>
    <div class="admin-card doc-type-card" onclick="openDocTypesManager()"><div class="admin-card-icon">&#x1F4CB;</div><div class="admin-card-label">Dokumente</div><div class="admin-card-title">Typen &amp; Vorlagen</div></div>
    <div class="admin-card master-only" onclick="exportAllData()"><div class="admin-card-icon">&#x1F4BE;</div><div class="admin-card-label">System</div><div class="admin-card-title">Daten exportieren</div></div>
    <div class="admin-card master-only" onclick="adminSection('audit')"><div class="admin-card-icon">&#x1F4CB;</div><div class="admin-card-label">System</div><div class="admin-card-title">Aktivitätslog</div></div>
    <div class="admin-card master-only" onclick="adminSection('tokens')"><div class="admin-card-icon">&#x1F511;</div><div class="admin-card-label">FiveM</div><div class="admin-card-title">Registrierungs-Tokens</div></div>
  </div>
  <div id="adminContent"></div>
</div>

<div class="tab-content" id="tab-livemap" style="padding:0;">
  <iframe id="livemapFrame" src="livemap.html" style="width:100%;flex:1;border:none;display:block;"></iframe>
</div>

<!-- Footer -->
<div style="position:fixed;bottom:10px;left:20px;font-size:.65rem;color:var(--muted);opacity:.6;font-family:'IBM Plex Mono',monospace;z-index:50;">
  Made by Nibi
</div>

</div>

<div class="modal-backdrop" id="mCitizen"><div class="modal">
  <div class="modal-header"><div class="modal-title" id="mCitizenTitle">Person hinzufügen</div><button class="modal-close" onclick="closeM('mCitizen')">X</button></div>
  <div class="modal-body">
    <input type="hidden" id="cEditId"/>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Name *</label><input class="form-input" id="cName" placeholder="Max Mustermann"/></div>
      <div class="form-group"><label class="form-label">Geburtsdatum</label><input class="form-input" id="cBirth" type="date"/></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Größe (cm)</label><input class="form-input" id="cHeight" type="number" placeholder="175"/></div>
      <div class="form-group"><label class="form-label">Telefon</label><input class="form-input" id="cTelefon" placeholder="+49 123"/></div>
    </div>
    <hr class="detail-divider"/>
    <div class="form-group"><label class="form-label">Verknüpfter Account</label>
      <select class="form-select" id="cLinked"><option value="">-- kein Account --</option></select>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mCitizen')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveCitizen()">Speichern</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mCitizenDetail"><div class="modal modal-lg">
  <div class="modal-header"><div class="modal-title" id="mCDTitle"></div><button class="modal-close" onclick="closeM('mCitizenDetail')">X</button></div>
  <div class="modal-body" id="mCDBody"></div>
  <div class="modal-footer">
    <button class="btn btn-ghost hidden" id="mCDEditBtn">Bearbeiten</button>
    <button class="btn btn-danger hidden" id="mCDDelBtn">Löschen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mDoc"><div class="modal modal-xl">
  <div class="modal-header"><div class="modal-title" id="mDocTitle">Dokument erstellen</div><button class="modal-close" onclick="closeM('mDoc')">X</button></div>
  <div class="modal-body">
    <input type="hidden" id="dEditId"/>
    <input type="hidden" id="dBlockedRanks" value="{}"/>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Typ *</label>
        <select class="form-select" id="dType"><option>Strafakte</option><option>Strafanzeige</option><option>Bußgeldbescheid</option><option>Haftbefehl</option><option>Entscheidung</option></select>
      </div>
      <div class="form-group"><label class="form-label">Bürger zuweisen</label>
        <select class="form-select" id="dBürger"><option value="">-- keine --</option></select>
      </div>
    </div>
    <div class="form-group"><label class="form-label">Titel *</label><input class="form-input" id="dTitle" placeholder="z.B. Einbruch Hauptstraße 14"/></div>
    <div class="form-group" id="dHeaderGrp">
      <label class="form-label" style="color:var(--danger)">Pflichttext (nicht editierbar)</label>
      <textarea class="form-textarea" id="dHeader" readonly style="height:60px;resize:none;background:rgba(190,6,6,.06);border-color:rgba(190,6,6,.3);color:var(--text2);font-family:monospace;font-size:.78rem;cursor:default;display:none"></textarea>
    </div>
    <div class="form-group"><label class="form-label">Inhalt (Freitext)</label><textarea class="form-textarea" id="dContent" style="height:200px;resize:vertical" placeholder="Dokumentinhalt eingeben..."></textarea></div>
    <div class="form-group"><label class="form-label">Interne Notiz</label><input class="form-input" id="dNote" placeholder="Interne Notiz..."/></div>
    <hr class="detail-divider"/>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Sichtbarkeitsstufe (1-5) *</label>
        <select class="form-select" id="dLevel">
          <option value="1">Stufe 1 – Öffentlich</option>
          <option value="2" selected>Stufe 2 – Beamte</option>
          <option value="3">Stufe 3 – Mittlere Ränge</option>
          <option value="4">Stufe 4 – Hohe Ränge</option>
          <option value="5">Stufe 5 – Höchste Ränge</option>
        </select>
        <div class="form-hint">Bestimmt, wer das Dokument sehen kann.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Weitere Personen</label>
        <div id="dAccessList" style="padding:8px;background:var(--panel2);border:1px solid var(--border);max-height:120px;overflow-y:auto;font-size:.75rem"></div>
        <button type="button" class="btn btn-ghost btn-sm" style="margin-top:6px;width:100%" onclick="openAddAccess()">+ Person hinzufügen</button>
        <div class="form-hint">Personen mit zusätzlichem Zugriff, auch wenn ihr Rang unter der Ebene liegt.</div>
      </div>
    </div>
    <hr class="detail-divider"/>
    <button type="button" class="btn btn-ghost btn-sm" style="width:100%" onclick="openDocAccessModal()" id="dAccessRulesBtn">⚙ Rang-Sichtbarkeit einstellen</button>
    <div class="form-hint" style="margin-top:4px">Bestimmte Ränge vom Zugriff auf dieses Dokument ausschließen.</div>
    <div style="margin-top:10px">
      <button type="button" class="btn btn-ghost btn-sm" style="width:100%;border-color:var(--accent)" onclick="openDocEditAccessModal()" id="dEditAccessBtn">✏️ Sonder-Bearbeitung einstellen</button>
      <div class="form-hint" style="margin-top:4px">Wer darf <strong>nur dieses Dokument</strong> bearbeiten – unabhängig vom Typ. Überschreibt keine globalen Einstellungen.</div>
    </div>
    <input type="hidden" id="dEditAccessLevel" value="0"/>
    <input type="hidden" id="dEditAccessList" value="[]"/>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mDoc')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveDoc()">Speichern</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mDocAccess" style="z-index:8700"><div class="modal modal-xl" style="max-height:92vh">
  <div class="modal-header">
    <div class="modal-title">⚙ Rang-Sichtbarkeit für dieses Dokument</div>
    <button class="modal-close" onclick="closeM('mDocAccess')">X</button>
  </div>
  <div class="modal-body" id="mDABody" style="padding:20px"></div>
  <div class="modal-footer">
    <div style="font-size:.72rem;color:var(--muted);flex:1">✅ = sieht das Dokument &nbsp;|&nbsp; ❌ = gesperrt</div>
    <button class="btn btn-ghost" onclick="closeM('mDocAccess')">Schließen</button>
    <button class="btn btn-primary" onclick="saveDocAccessRules()">Übernehmen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mDocEditAccess" style="z-index:8700"><div class="modal modal-lg" style="max-height:88vh">
  <div class="modal-header">
    <div class="modal-title">✏️ Sonder-Bearbeitung – nur dieses Dokument</div>
    <button class="modal-close" onclick="closeM('mDocEditAccess')">X</button>
  </div>
  <div class="modal-body" style="padding:20px">
    <div style="font-size:.7rem;color:var(--muted);margin-bottom:14px">Diese Einstellungen überschreiben <strong>nur für dieses Dokument</strong> wer es bearbeiten darf. Sie wirken sich <u>nicht</u> auf andere Dokumente des gleichen Typs aus.</div>
    <div class="form-group">
      <label class="form-label">Mindest-Stufe zum Bearbeiten</label>
      <select class="form-select" id="deaLevel">
        <option value="0">Standard (Typ-Einstellung verwenden)</option>
        <option value="1">Stufe 1+ (Öffentliche Beamte)</option>
        <option value="2">Stufe 2+ (Reguläre Beamte)</option>
        <option value="3">Stufe 3+ (Mittlere Ränge)</option>
        <option value="4">Stufe 4+ (Hohe Ränge)</option>
        <option value="5">Stufe 5 (Nur Höchste Ränge)</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Weitere Personen mit Bearbeitungsrecht</label>
      <div id="deaPersonList" style="padding:8px;background:var(--panel2);border:1px solid var(--border);max-height:140px;overflow-y:auto;font-size:.75rem;margin-bottom:6px"></div>
      <select class="form-select" id="deaPersonSelect" style="margin-bottom:6px"><option value="">-- Person auswählen --</option></select>
      <button type="button" class="btn btn-ghost btn-sm" style="width:100%" onclick="addDeaPerson()">+ Person hinzufügen</button>
      <div class="form-hint">Diese Personen können das Dokument bearbeiten, unabhängig von ihrer Stufe.</div>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mDocEditAccess')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveDocEditAccess()">Übernehmen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mDocDetail"><div class="modal modal-xl">
  <div class="modal-header"><div class="modal-title" id="mDDTitle"></div><button class="modal-close" onclick="closeM('mDocDetail')">X</button></div>
  <div class="modal-body" id="mDDBody"></div>
  <div class="modal-footer">
    <button class="btn btn-ghost hidden" id="mDDEditBtn">Bearbeiten</button>
    <button class="btn btn-danger hidden" id="mDDDelBtn">Löschen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mCar"><div class="modal">
  <div class="modal-header"><div class="modal-title" id="mCarTitle">Fahrzeug hinzufügen</div><button class="modal-close" onclick="closeM('mCar')">X</button></div>
  <div class="modal-body">
    <input type="hidden" id="carEditId"/>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Modell *</label><input class="form-input" id="carModel" placeholder="BMW M3"/></div>
      <div class="form-group"><label class="form-label">Kennzeichen *</label><input class="form-input" id="carPlate" placeholder="ABC-123"/></div>
    </div>
    <div class="form-group"><label class="form-label">Besitzer</label><select class="form-select" id="carBesitzer"><option value="">-- kein Besitzer --</option></select></div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mCar')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveCar()">Speichern</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mCarDetail"><div class="modal">
  <div class="modal-header"><div class="modal-title" id="mCarDTitle"></div><button class="modal-close" onclick="closeM('mCarDetail')">X</button></div>
  <div class="modal-body" id="mCarDBody"></div>
  <div class="modal-footer">
    <button class="btn btn-ghost hidden" id="mCarDEditBtn">Bearbeiten</button>
    <button class="btn btn-danger hidden" id="mCarDDelBtn">Löschen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mLex"><div class="modal modal-lg">
  <div class="modal-header"><div class="modal-title" id="mLexTitle">Lexikon-Eintrag</div><button class="modal-close" onclick="closeM('mLex')">X</button></div>
  <div class="modal-body">
    <input type="hidden" id="lexEditId"/>
    <div class="form-row">
      <div class="form-group"><label class="form-label">Titel *</label><input class="form-input" id="lexTitle"/></div>
      <div class="form-group"><label class="form-label">Kategorie</label><input class="form-input" id="lexCat" placeholder="z.B. Strafrecht"/></div>
    </div>
    <div class="form-group"><label class="form-label">Inhalt *</label><textarea class="form-textarea" id="lexContent" style="height:180px"></textarea></div>
    <div class="form-group"><label class="form-label">Status</label>
      <select class="form-select" id="lexActive"><option value="1">Aktiv</option><option value="0">Inaktiv</option></select>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mLex')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveLexikon()">Speichern</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mLexDetail"><div class="modal modal-lg">
  <div class="modal-header"><div class="modal-title" id="mLDTitle"></div><button class="modal-close" onclick="closeM('mLexDetail')">X</button></div>
  <div class="modal-body" id="mLDBody"></div>
  <div class="modal-footer">
    <button class="btn btn-ghost hidden" id="mLDEditBtn">Bearbeiten</button>
    <button class="btn btn-danger hidden" id="mLDDelBtn">Löschen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mIdAssign"><div class="modal">
  <div class="modal-header"><div class="modal-title">ID zuweisen</div><button class="modal-close" onclick="closeM('mIdAssign')">X</button></div>
  <div class="modal-body">
    <div id="idAssignInfo" style="margin-bottom:14px;padding:14px;background:var(--panel2);border:1px solid var(--border);font-size:.85rem"></div>
    <div class="form-group"><label class="form-label">Bürgerprofil *</label>
      <select class="form-select" id="idAssignCit"><option value="">-- Bürger auswählen --</option></select>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mIdAssign')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveIdAssign()">Zuweisen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mDocTypes"><div class="modal modal-lg">
  <div class="modal-header"><div class="modal-title">Document Typen &amp; Vorlagen</div><button class="modal-close" onclick="closeM('mDocTypes')">X</button></div>
  <div class="modal-body" id="mDocTypesBody"></div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mDocTypes')">Schließen</button>
  </div>
</div></div>

<div class="modal-backdrop" id="mDocTypeEdit"><div class="modal modal-lg">
  <div class="modal-header"><div class="modal-title" id="mDTETitle">Typ bearbeiten</div><button class="modal-close" onclick="closeM('mDocTypeEdit')">X</button></div>
  <div class="modal-body">
    <input type="hidden" id="dteEditName"/>
    <div class="form-group"><label class="form-label">Typname *</label><input class="form-input" id="dteName" placeholder="z.B. Ermittlungsakte"/></div>
    <div class="form-group"><label class="form-label">Pflichttext (immer oben, nicht löschbar)</label>
      <div style="font-size:.6rem;color:var(--muted);margin-bottom:6px">Dieser Text wird immer oben angezeigt and cannot be removed by the user. Platzhalter: {DATUM}, {BEAMTER}, {BÜRGER}.</div>
      <textarea class="form-textarea" id="dteHeader" style="height:90px;font-family:monospace;font-size:.8rem;border-color:var(--danger)" placeholder="z.B. OFFIZIELLE STRAFAKTE - COAST.NET&#10;Ausgestellt am: {DATE} von {OFFICER}"></textarea>
    </div>
    <div class="form-group"><label class="form-label">Vorlage (bearbeitbarer Bereich)</label>
      <div style="font-size:.6rem;color:var(--muted);margin-bottom:6px">Dieser Teil erscheint vorausgefüllt and can be edited by the user. Platzhalter: {NAME}, {DATUM}, {BEAMTER}, {BÜRGER}.</div>
      <textarea class="form-textarea" id="dteTemplate" style="height:160px;font-family:monospace;font-size:.8rem" placeholder="Vorlage eingeben..."></textarea>
    </div>
    <hr class="detail-divider"/>
    <div class="form-label" style="margin-bottom:10px;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em">&#x1F512; Typ-Berechtigungen</div>
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Wer kann diesen Typ <strong>sehen</strong>?</label>
        <select class="form-select" id="dteVisLevel">
          <option value="0">Alle (keine Einschränkung)</option>
          <option value="1">Stufe 1+ (Öffentliche Beamte)</option>
          <option value="2">Stufe 2+ (Reguläre Beamte)</option>
          <option value="3">Stufe 3+ (Mittlere Ränge)</option>
          <option value="4">Stufe 4+ (Hohe Ränge)</option>
          <option value="5">Stufe 5 (Nur Höchste Ränge)</option>
        </select>
        <div class="form-hint">Mindest-Doc-Level um Dokumente dieses Typs zu sehen.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Wer kann diesen Typ <strong>bearbeiten</strong>?</label>
        <select class="form-select" id="dteEditLevel">
          <option value="0">Alle mit doc_edit Recht</option>
          <option value="1">Stufe 1+ (Öffentliche Beamte)</option>
          <option value="2">Stufe 2+ (Reguläre Beamte)</option>
          <option value="3">Stufe 3+ (Mittlere Ränge)</option>
          <option value="4">Stufe 4+ (Hohe Ränge)</option>
          <option value="5">Stufe 5 (Nur Höchste Ränge)</option>
        </select>
        <div class="form-hint">Mindest-Level um Dokumente dieses Typs zu bearbeiten.</div>
      </div>
    </div>
  </div>
  <div class="modal-footer">
    <button class="btn btn-ghost" onclick="closeM('mDocTypeEdit')">Abbrechen</button>
    <button class="btn btn-primary" onclick="saveDocType()">Speichern</button>
  </div>
</div></div>

